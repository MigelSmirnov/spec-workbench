{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "frontend_context.schema.json",
  "title": "Spec Workbench frontend context manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "full_documents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "slices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "headings"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "headings": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": ["full_documents"],
      "properties": {
        "full_documents": {
          "minItems": 1
        }
      }
    },
    {
      "required": ["slices"],
      "properties": {
        "slices": {
          "minItems": 1
        }
      }
    }
  ]
}
