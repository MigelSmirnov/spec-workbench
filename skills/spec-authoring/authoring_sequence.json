      "gate_args": ["--check"],
      "next": "state4_reviewed_flows"
    },
    {
      "id": "state4_reviewed_flows",
      "semantic_state": 4,
      "status": "available",
      "mode": "deterministic_gate",
      "optional_plan": "40_flow_plan.json",
      "gate_tool": "tools/design_stage4.py",
      "gate_args": ["--lint"],
      "next_tool_args": ["--next"],
      "next": "state5_public_module_operations"
    },
    {
      "id": "state5_public_module_operations",
      "semantic_state": 5,
      "status": "available",
      "mode": "deterministic_gate",
      "optional_plan": "50_api_plan.json",
      "gate_tool": "tools/design_stage5.py",
      "gate_args": ["--lint"],
      "next_tool_args": ["--next"],
      "next": "post_state5_toolchain"
    },
    {
      "id": "post_state5_toolchain",
      "status": "promotion_pending",
      "mode": "blocked_boundary",
      "reason": "The mature State 6-9 implementation currently contains project-specific Cabinet policy and must be refactored before promotion to main.",
      "target_phases": [
        "pre_contract_structured_data_closure",
        "state6_exact_contracts",
        "deterministic_persistence_closure",
        "deterministic_http_route_closure",
        "deterministic_http_context_closure",
        "state7_notes",
        "state8_assembly",
        "stage8_1_module_review",
        "stage9_factory_admission"
      ]
    }
  ],
  "principles": {
    "one_machine_sequence": true,
    "project_branches_own_data_not_orchestration": true,
    "mcp_must_wrap_same_pipeline_api": true,
    "normal_navigation_must_not_scan_arbitrary_refs": true,
    "project_specific_policy_must_not_be_hardcoded_in_generic_tools": true
  }
}
