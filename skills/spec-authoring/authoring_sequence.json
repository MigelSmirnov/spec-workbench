      "edit_tool": "tools/design_editor.py",
      "next": "state1_models"
    },
    {
      "id": "state1_models",
      "semantic_state": 1,
      "status": "available",
      "mode": "deterministic_gate",
      "inspect_tool": "tools/design_index.py",
      "gate_tool": "tools/design_lint.py",
      "gate_args": ["--state", "1"],
      "edit_tool": "tools/design_editor.py",
      "next": "state2_rules_decisions"
    },
    {
      "id": "state2_rules_decisions",
      "semantic_state": 2,
      "status": "available",
      "mode": "deterministic_gate",
      "inspect_tool": "tools/design_index.py",
      "gate_tool": "tools/design_lint.py",
      "gate_args": ["--state", "2"],
      "edit_tool": "tools/design_editor.py",
      "next": "state3_module_responsibilities"
    },
    {
      "id": "state3_module_responsibilities",
      "semantic_state": 3,
      "status": "available",
      "mode": "deterministic_gate",
      "gate_tool": "tools/design_stage3.py",
      "gate_args": ["--lint"],
      "next": "state2_to_state3_trace"
    },
    {
      "id": "state2_to_state3_trace",
      "transition": "2->3",
      "status": "available",
      "mode": "deterministic_gate",
      "artifact": "30_trace.json",
