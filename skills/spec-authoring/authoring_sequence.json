{
  "schema_version": "spec_workbench_authoring_sequence.v1",
  "semantic_states": [
    {"state": 0, "id": "product_frame"},
    {"state": 1, "id": "models"},
    {"state": 2, "id": "rules_decisions"},
    {"state": 3, "id": "module_responsibilities"},
    {"state": 4, "id": "reviewed_flows"},
    {"state": 5, "id": "public_module_operations"},
    {"state": 6, "id": "exact_contracts_internal_functions"},
    {"state": 7, "id": "notes"}
  ],
  "intermediate_phases": [
    {
      "id": "pre_contract_structured_data_closure",
      "after": "public_module_operations",
      "before": "exact_contracts_internal_functions",
      "compatibility_artifacts": ["60_data_closure.json"]
    },
    {
      "id": "deterministic_persistence_backend_closure",
      "after": "exact_contracts_internal_functions",
      "before": "deterministic_http_route_closure",
      "conditional": "rules.persistence_backend is used",
      "compatibility_artifacts": ["70_persistence_closure.json"],
      "deterministic_tool": "tools/design_persistence_authoring.py"
    },
    {
      "id": "deterministic_http_route_closure",
      "after": "deterministic_persistence_backend_closure",
      "before": "deterministic_http_router_context_closure",
      "conditional": "rules.http_router_backend is used",
      "compatibility_artifacts": ["70_router_closure.json"]
    },
    {
      "id": "deterministic_http_router_context_closure",
      "after": "deterministic_http_route_closure",
      "before": "deterministic_http_router_ir_assembly",
      "conditional": "rules.http_router_backend is used",
      "compatibility_artifacts": ["70_router_context.json"]
    },
    {
      "id": "deterministic_http_router_ir_assembly",
      "after": "deterministic_http_router_context_closure",
      "before": "notes",
      "conditional": "rules.http_router_backend is used",
      "deterministic_tool": "tools/design_router_ir.py"
    }
  ],
  "operational_stages": [
    {
      "stage": "8",
      "id": "final_assembly",
      "projection_tool": "tools/design_spec_projection.py",
      "deterministic_tool": "tools/design_assembly.py"
    },
    {
      "stage": "8.1",
      "id": "assembled_module_review",
      "after": "final_assembly",
      "deterministic_tool": "tools/design_module_review.py"
    },
    {
      "stage": "9",
      "id": "factory_admission_and_handoff",
      "after": "assembled_module_review",
      "read_only_gate": "tools/design_factory_admission.py",
      "mutation_tool": "tools/export_to_factory.py",
      "ends_before": "factory_route_b"
    }
  ],
  "invariants": {
    "canonical_python_signatures_owner": "exact_contracts_internal_functions",
    "pre_contract_data_may_define_contract_dependent_backend_ir": false,
    "persistence_requires_canonical_contracts": true,
    "persistence_may_define_signatures": false,
    "persistence_final_ir_is_deterministic_projection": true,
    "invalid_persistence_backend_allows_llm_fallback": false,
    "router_requires_canonical_contracts": true,
    "router_requires_canonical_handler_per_external_operation": true,
    "router_may_define_signatures": false,
    "router_final_ir_is_deterministic_projection": true,
    "legacy_router_is_evidence_only": true,
    "artifact_prefixes_define_semantic_state": false,
    "invalid_http_router_backend_allows_llm_fallback": false,
    "notes_require_exact_scope": true,
    "notes_require_closed_class_marker": true,
    "notes_structured_references_must_resolve": true,
    "notes_semantic_stubs_block_handoff": true,
    "notes_suspicious_class_combinations_require_review": true,
    "factory_handoff_requires_admission": true,
    "factory_route_b_is_outside_stage_9": true
  }
}
