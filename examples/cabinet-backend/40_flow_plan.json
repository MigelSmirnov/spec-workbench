{
  "schema_version": "spec_workbench_state4_plan.v1",
  "flows": [
    {
      "key": "flow:synchronize_invoice_to_local_archive",
      "purpose": "Transfer one exact VPS invoice work package into local durable custody without collapsing delivery into acceptance.",
      "required_modules": ["module:synchronization", "module:durable_archive"],
      "candidate_capabilities": [
        "capability:synchronization.synchronize_invoice_work",
        "capability:durable_archive.accept_transfer_manifest",
        "capability:durable_archive.verify_durable_acceptance"
      ]
    },
    {
      "key": "flow:accept_local_source_attachment",
      "purpose": "Accept a locally supplied source attachment through authorization, source validation, and durable archive state transition.",
      "required_modules": ["module:access_control", "module:durable_archive"],
      "candidate_capabilities": [
        "capability:access_control.authorize_operation",
        "capability:durable_archive.attach_local_source",
        "capability:durable_archive.get_source_status"
      ]
    },
    {
      "key": "flow:refresh_registry_and_validate_assignment",
      "purpose": "Refresh Registry-derived project context and validate an existing Card assignment without silently rewriting it.",
      "required_modules": ["module:registry_context"],
      "candidate_capabilities": [
        "capability:registry_context.refresh_registry_context",
        "capability:registry_context.validate_card_assignment",
        "capability:registry_context.get_assignment_validation"
      ]
    },
    {
      "key": "flow:calculate_plan_actual",
      "purpose": "Produce reproducible plan-versus-actual analysis from pinned Cabinet, Registry, and PresuPro evidence.",
      "required_modules": ["module:plan_actual", "module:durable_archive", "module:registry_context"],
      "candidate_capabilities": [
        "capability:plan_actual.refresh_estimate_snapshot",
        "capability:plan_actual.calculate_plan_actual",
        "capability:durable_archive.get_archived_invoice",
        "capability:registry_context.get_work_object"
      ]
    },
    {
      "key": "flow:publish_invoice_to_holded",
      "purpose": "Publish one exact eligible confirmed Invoice Card revision to Holded with business eligibility separated from gateway mechanics and ambiguous-outcome reconciliation.",
      "required_modules": ["module:access_control", "module:durable_archive", "module:holded_publication", "module:holded_gateway"],
      "candidate_capabilities": [
        "capability:access_control.authorize_operation",
        "capability:durable_archive.get_archived_invoice",
        "capability:holded_publication.request_holded_publication",
        "capability:holded_publication.reconcile_holded_publication",
        "capability:holded_gateway.create_holded_purchase",
        "capability:holded_gateway.lookup_holded_purchase"
      ]
    },
    {
      "key": "flow:release_vps_working_copy",
      "purpose": "Evaluate and execute the manual VPS working-copy release decision only after durable local acceptance evidence exists.",
      "required_modules": ["module:retention_release", "module:durable_archive", "module:synchronization"],
      "candidate_capabilities": [
        "capability:retention_release.evaluate_vps_release",
        "capability:retention_release.request_manual_vps_release",
        "capability:durable_archive.verify_durable_acceptance",
        "capability:synchronization.get_sync_status"
      ]
    }
  ]
}
