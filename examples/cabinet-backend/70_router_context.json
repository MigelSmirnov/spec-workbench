{
  "schema_version": "spec_workbench_router_context.v1",
  "status": "closed",
  "backend": {"framework": "fastapi", "emitter": "fastapi_sync_v1"},
  "wiring": {
    "module": "api",
    "app_factory": "create_app",
    "request_parameter": "request",
    "state_bindings": {
      "access_control": {"factory_parameter": "access_control", "state_attribute": "access_control"},
      "archive": {"factory_parameter": "archive", "state_attribute": "archive"},
      "registry": {"factory_parameter": "registry", "state_attribute": "registry"},
      "holded_gateway": {"factory_parameter": "holded_gateway", "state_attribute": "holded_gateway"},
      "synchronization": {"factory_parameter": "synchronization", "state_attribute": "synchronization"}
    },
    "credential_extractors": {
      "bearer": {
        "kind": "header_scheme",
        "function": "extract_bearer_credential",
        "header": "Authorization",
        "scheme": "Bearer",
        "reject_with": "AuthenticationRequiredError"
      }
    }
  },
  "principals": {
    "local_actor": {
      "resolver": "resolve_local_principal",
      "args": [
        {"ref": "slot", "name": "access_control"},
        {"ref": "credential", "name": "bearer"}
      ]
    }
  },
  "auth_policies": {
    "local_bearer": {"principal": "local_actor"}
  },
  "projections": [],
  "error_policy": {
    "body": "empty",
    "default_status": 500,
    "mapping": [
      {"exception":"AuthenticationRequiredError","status":401},
      {"exception":"OperationForbiddenError","status":403},
      {"exception":"InvoiceNotFoundError","status":404},
      {"exception":"SourceAttachmentRejectedError","status":422},
      {"exception":"RegistryContextUnavailableError","status":503},
      {"exception":"AssignmentValidationNotFoundError","status":404},
      {"exception":"EstimateObservationRejectedError","status":422},
      {"exception":"PlanActualPreconditionError","status":422},
      {"exception":"HoldedPublicationIneligibleError","status":409},
      {"exception":"HoldedReconciliationRequiredError","status":409},
      {"exception":"VpsReleaseBlockedError","status":409}
    ],
    "unavailable_to_module": []
  },
  "unresolved": []
}
