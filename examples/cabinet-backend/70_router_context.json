{
  "schema_version": "spec_workbench_router_context.v1",
  "status": "in_progress",
  "backend": {"framework": "fastapi", "emitter": "fastapi_sync_v1"},
  "wiring": {
    "module": "api",
    "app_factory": "create_app",
    "request_parameter": "request",
    "state_bindings": {
      "access_control": {"factory_parameter": "access_control", "state_attribute": "access_control"}
    },
    "credential_extractors": {
      "bearer": {
        "kind": "header_scheme",
        "function": "extract_bearer_credential",
        "scheme": "Bearer",
        "exception": "unresolved"
      }
    }
  },
  "principals": {
    "local_actor": {
      "resolver": "resolve_local_principal",
      "args": [
        {"ref": "slot", "name": "access_control"},
        {"ref": "credential", "name": "bearer"}
      ]
    }
  },
  "auth_policies": {
    "local_bearer": {"principal": "local_actor"}
  },
  "projections": [],
  "error_policy": {
    "body": "empty",
    "default_status": 500,
    "mapping": [],
    "unavailable_to_module": []
  },
  "unresolved": [
    {
      "topic": "error_taxonomy",
      "reason": "State 5 records semantic rejection/error forms, but canonical exception symbols and their HTTP status mapping have not yet been frozen. Do not invent exception classes merely to make http_router_backend valid."
    }
  ]
}
