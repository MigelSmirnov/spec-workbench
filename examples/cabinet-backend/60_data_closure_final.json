      "InvoiceSynchronization": {
        "class": "master"
      },
      "VpsConnectionObservation": {
        "class": "issued"
      },
      "InvoiceImport": {
        "class": "master"
      },
      "ImportQuarantine": {
        "class": "master"
      },
      "InvoiceTransferReceipt": {
        "class": "issued"
      },
      "InvoiceWorkingReplica": {
        "class": "master"
      },
      "SynchronizationConflict": {
        "class": "master"
      },
      "InvoiceLineEstimateMatch": {
        "class": "master"
      },
      "HoldedPublication": {
        "class": "master"
      },
      "HoldedPublicationAttempt": {
        "class": "issued"
      },
      "HoldedPurchaseLookupEvidence": {
        "class": "issued"
      },
      "IncompleteSourceAcceptance": {
        "class": "issued"
      },
      "SourceLossDecision": {
        "class": "issued"
      },
      "LocalServicePrincipal": {
        "class": "master"
      },
      "LocalServiceCredential": {
        "class": "master"
      },
      "AuthenticationThrottleState": {
        "class": "master"
      },
      "SecurityAuditRecord": {
        "class": "issued"
      },
      "ArchiveBytePublication": {
        "class": "master"
      },
      "EstimateSnapshot": {
        "class": "issued"
      },
      "InvoiceLineMatchProposal": {
        "class": "issued"
      }
    },
    "properties": {
      "holded_wire_date": [
        "result % 86400 == 0",
        "value.year >= 1970 implies result >= 0",
        "value.year < 1970 implies result < 0"
      ],
      "verify_service_secret": [
        "not secret_hash.startswith('$argon2id$') implies result is False",
        "secret == '' implies result is False",
        "pepper == '' implies result is False"
      ]
    },
    "determinism": {
      "holded_wire_date": true,
      "verify_service_secret": true,
      "issue_service_credential": false
    }
  },
  "closure_notes": [
    "Source upload size is a deployment boundary in config.source_upload.max_file_size_bytes; durable_archive enforces the policy without owning the numeric value.",
    "External projection persistence is not classified as mirrored until a later accepted storage schema requires that Factory-specific classification.",
    "Stage 7.1 runtime semantic oracles remain external acceptance artifacts and are not duplicated into properties merely to satisfy assembly.",
    "Local access-control deployment reads PostgreSQL, pepper, and Linux-owner values from named environment variables; secret values are never specification data."
  ],
