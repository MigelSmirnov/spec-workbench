      "WorkObject": {"class": "master"},
      "CardObjectAssignmentObservation": {"class": "issued"},
      "ObjectAssignmentValidation": {"class": "issued"},
      "InvoiceTransferManifest": {"class": "issued"},
      "InvoiceSynchronization": {"class": "master"},
      "InvoiceImport": {"class": "master"},
      "ImportQuarantine": {"class": "master"},
      "InvoiceTransferReceipt": {"class": "issued"},
      "InvoiceWorkingReplica": {"class": "master"},
      "SynchronizationConflict": {"class": "master"},
      "InvoiceLineEstimateMatch": {"class": "master"},
      "HoldedPublication": {"class": "master"},
      "HoldedPublicationAttempt": {"class": "issued"},
      "IncompleteSourceAcceptance": {"class": "issued"},
      "SourceLossDecision": {"class": "issued"},
      "LocalServicePrincipal": {"class": "master"},
      "LocalServiceCredential": {"class": "master"},
      "AuthenticationThrottleState": {"class": "master"},
      "SecurityAuditRecord": {"class": "issued"},
