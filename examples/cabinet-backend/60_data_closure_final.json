{
  "schema_version": "spec_workbench_state6_data_final.v1",
  "status": "closed",
  "sections": {
    "config": {
      "role": "data",
      "schema_version": 1,
      "source_upload": {
        "max_file_size_bytes": 52428800
      },
      "access_control": {
        "database_url_env": "CABINET_DATABASE_URL",
        "credential_pepper_env": "CABINET_CREDENTIAL_PEPPER",
        "deployment_owner_uid_env": "CABINET_DEPLOYMENT_OWNER_UID"
      },
      "holded_runtime": {
        "credential_env": "HOLDED_V1_API_KEY"
      },
      "persistence": {
        "holded_publication_table_name": "holded_publications",
        "work_object_table_name": "work_objects",
        "assignment_validation_table_name": "assignment_validations",
        "holded_attempt_table_name": "holded_publication_attempts",
        "holded_lookup_evidence_table_name": "holded_lookup_evidence",
        "synchronization_table_name": "invoice_synchronizations",
        "catalogue_publication_table_name": "registry_catalogue_publications",
        "connection_observation_table_name": "vps_connection_observations",
        "estimate_snapshot_table_name": "estimate_snapshots",
        "match_proposal_table_name": "invoice_line_match_proposals",
        "estimate_match_table_name": "invoice_line_estimate_matches",
        "invoice_card_table_name": "invoice_cards",
        "invoice_card_revision_table_name": "invoice_card_revisions",
        "source_binary_table_name": "source_binaries",
        "source_replica_table_name": "source_binary_replicas",
        "transfer_manifest_table_name": "invoice_transfer_manifests",
        "transfer_receipt_table_name": "invoice_transfer_receipts",
        "byte_publication_table_name": "archive_byte_publications",
        "incomplete_source_acceptance_table_name": "incomplete_source_acceptances",
        "source_loss_decision_table_name": "source_loss_decisions",
        "assignment_observation_table_name": "card_object_assignment_observations",
        "principal_table_name": "local_service_principals",
        "credential_table_name": "local_service_credentials",
        "throttle_state_table_name": "authentication_throttle_states",
        "security_audit_table_name": "security_audit_records"
      }
    },
    "rules": {
      "role": "data",
      "schema_version": 1,
      "synchronization": {
        "delivery_implies_durable_acceptance": false,
        "direction": "backend_to_vps_only",
        "unknown_outcome_reconciliation": "read_only",
        "durable_reservation_before_mutation": true,
        "reservation_status": "reserved",
        "issued_status": "issued",
        "status_transitions": [
          "reserved->issued",
          "issued->delivered",
          "issued->failed",
          "issued->unknown_outcome"
        ],
        "supported_manifest_versions": [
          "v1"
        ]
      },
      "holded_publication": {
        "max_automatic_create_attempts_per_logical_attempt": 1,
        "ambiguous_create_allows_automatic_retry": false,
        "recovered_candidate_requires_full_verification": true,
        "clear_create_requires_readback_verification": true,
        "status_transitions": [
          "pending->verified",
          "pending->failed",
          "pending->payload_mismatch",
          "pending->outcome_unknown",
          "pending->reconciliation_required",
          "outcome_unknown->verified",
          "outcome_unknown->duplicate_conflict",
          "outcome_unknown->payload_mismatch",
          "outcome_unknown->outcome_unknown",
          "reconciliation_required->verified",
          "reconciliation_required->duplicate_conflict",
          "reconciliation_required->payload_mismatch",
          "reconciliation_required->outcome_unknown",
          "reconciliation_required->reconciliation_required"
        ],
        "payload_apply_contact_defaults": false,
        "payload_approve_doc": false,
        "readback_date_tolerance_seconds": 86400,
        "readback_currency_case_insensitive": true
      },
      "registry_context": {
        "registry_is_read_only_from_cabinet": true,
        "registry_status_rewrites_immutable_card": false,
        "active_exact_match_result": "valid",
        "archived_requires_review": true,
        "missing_requires_review": true,
        "archived_means_completed": false,
        "archived_project_result": "project_closed",
        "missing_project_result": "project_missing"
      },
      "plan_actual": {
        "confirmed_matches_only": true,
        "source_records_are_immutable": true,
        "analysis_grain": "estimate_item",
        "planned_quantity_source": "EstimateItemSnapshot.quantity",
        "planned_amount_source": "EstimateItemSnapshot.total",
        "actual_quantity_source": "confirmed_matched_invoice_line.quantity",
        "actual_amount_source": "InvoiceCardLine.gross_amount",
        "actual_amount_basis": "gross",
        "matched_line_aggregation": "sum",
        "quantity_variance": "actual_minus_planned",
        "amount_variance": "actual_minus_planned",
        "remaining_quantity": "planned_minus_actual_unclamped",
        "unmatched_actual_contributes_to_project_actual": true,
        "unmatched_actual_contributes_to_item_actual": false,
        "implicit_unit_conversion_allowed": false,
        "implicit_currency_conversion_allowed": false,
        "implicit_tax_basis_conversion_allowed": false,
        "proposal_required_equalities": [
          "unit",
          "currency"
        ],
        "proposal_quantity_equal_weight": "0.5",
        "proposal_unit_price_proximity_weight": "0.5",
        "proposal_unit_price_close_threshold": "0.9",
        "proposal_score_places": 4,
        "proposal_ordering": [
          "score_desc",
          "invoice_line_id_asc",
          "estimate_item_id_asc"
        ]
      },
      "source_security": {
        "accepted_media_types": [
          "image/jpeg",
          "image/png",
          "application/pdf"
        ],
        "require_content_signature_verification": true,
        "trust_filename_or_declared_media_type": false,
        "require_configured_finite_size_limit": true,
        "bounded_parsing_required": true
      },
      "access_control": {
        "progressive_delay_after_failures": 5,
        "temporary_block_after_failures": 10,
        "temporary_block_seconds": 900,
        "credential_hash_algorithm": "argon2id",
        "offline_administration_only": true
      },
      "durable_archive": {
        "accepted_head_archive_status": "active"
      },
      "runtime_clock": {
        "timestamp_source": "datetime.now(timezone.utc)",
        "naive_datetimes_allowed": false
      },
      "holded_document_projection": {
        "document_id": "id",
        "supplier_code": "contactCode",
        "supplier_name": "contactName",
        "supplier_invoice_number": "docNumber",
        "document_date": "date",
        "currency": "currency",
        "description": "desc",
        "items": "products",
        "gross_total": "total",
        "raw_status": "status",
        "item_name": "name",
        "item_description": "desc",
        "item_units": "units",
        "item_tax": "tax",
        "item_subtotal": "price"
      }
    },
    "persistence": {
      "StoredInvoiceCard": {
        "class": "master"
      },
      "StoredInvoiceCardRevision": {
        "class": "issued"
      },
      "InvoiceCardValidationRecord": {
