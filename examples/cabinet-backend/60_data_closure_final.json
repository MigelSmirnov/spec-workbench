{
  "schema_version": "spec_workbench_state6_data_final.v1",
  "status": "closed",
  "sections": {
    "config": {
      "role": "data",
      "schema_version": 1,
      "source_upload": {
        "max_file_size_bytes": 52428800
      },
      "access_control": {
        "database_url_env": "CABINET_DATABASE_URL",
        "credential_pepper_env": "CABINET_CREDENTIAL_PEPPER",
        "deployment_owner_uid_env": "CABINET_DEPLOYMENT_OWNER_UID"
      },
      "holded_runtime": {
        "credential_env": "HOLDED_V1_API_KEY"
      }
    },
    "rules": {
      "role": "data",
      "schema_version": 1,
      "synchronization": {
        "delivery_implies_durable_acceptance": false
      },
      "retention_release": {
        "mode": "manual",
        "require_durable_local_verification_before_release": true,
        "registry_status_may_trigger_release": false,
        "required_working_set_coverage": "all"
      },
      "holded_publication": {
        "max_automatic_create_attempts_per_logical_attempt": 1,
        "ambiguous_create_allows_automatic_retry": false,
        "recovered_candidate_requires_full_verification": true,
        "clear_create_requires_readback_verification": true
      },
      "registry_context": {
        "registry_is_read_only_from_cabinet": true,
        "registry_status_rewrites_immutable_card": false,
        "active_exact_match_result": "valid",
        "archived_requires_review": true,
        "missing_requires_review": true,
        "archived_means_completed": false
      },
      "plan_actual": {
        "confirmed_matches_only": true,
        "source_records_are_immutable": true,
        "analysis_grain": "estimate_item",
        "planned_quantity_source": "EstimateItemSnapshot.quantity",
        "planned_amount_source": "EstimateItemSnapshot.total",
        "actual_quantity_source": "confirmed_matched_invoice_line.quantity",
        "actual_amount_source": "confirmed_matched_invoice_line.total",
        "matched_line_aggregation": "sum",
        "quantity_variance": "actual_minus_planned",
        "amount_variance": "actual_minus_planned",
        "remaining_quantity": "planned_minus_actual_unclamped",
        "unmatched_actual_contributes_to_project_actual": true,
        "unmatched_actual_contributes_to_item_actual": false,
        "implicit_unit_conversion_allowed": false,
        "implicit_currency_conversion_allowed": false,
        "implicit_tax_basis_conversion_allowed": false
      },
      "source_security": {
        "accepted_media_types": ["image/jpeg", "image/png", "application/pdf"],
        "require_content_signature_verification": true,
        "trust_filename_or_declared_media_type": false,
        "require_configured_finite_size_limit": true,
        "bounded_parsing_required": true
      },
      "access_control": {
        "progressive_delay_after_failures": 5,
        "temporary_block_after_failures": 10,
        "temporary_block_seconds": 900,
        "credential_hash_algorithm": "argon2id",
        "offline_administration_only": true
      }
    },
    "persistence": {
      "StoredInvoiceCard": {"class": "master"},
      "StoredInvoiceCardRevision": {"class": "issued"},
      "InvoiceCardValidationRecord": {"class": "issued"},
      "DuplicateCandidateReview": {"class": "master"},
      "SourceBinary": {"class": "master"},
