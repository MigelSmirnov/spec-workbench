{
  "schema_version": "spec_workbench_data_provider_backend_closure.v1",
  "status": "closed",
  "backend_ir": {
    "kind": "data_provider_backend",
    "schema_version": 2,
    "backend": {
      "emitter": "python_constant_data_v1"
    },
    "wiring": {
      "module": "data_provider",
      "models_module": "domain_models"
    },
    "constants": {
      "CONFLICT_COPY_MARK": {
        "value_type": "string",
        "value": ".sync-conflict-"
      },
      "IGNORED_NAME_PREFIXES": {
        "value_type": "string_tuple",
        "value": [
          ".",
          "~syncthing~"
        ]
      },
      "IGNORED_NAME_SUFFIXES": {
        "value_type": "string_tuple",
        "value": [
          ".tmp",
          "~"
        ]
      },
      "INTAKE_ID_PREFIX": {
        "value_type": "string",
        "value": "deliverer-photo-"
      },
      "INTAKE_SOURCE": {
        "value_type": "string",
        "value": "syncthing"
      },
      "LOCKS_FOLDER": {
        "value_type": "string",
        "value": "locks"
      },
      "LOCK_FILE_MODE": {
        "value_type": "positive_integer",
        "value": 384
      },
      "LOCK_FILE_SUFFIX": {
        "value_type": "string",
        "value": ".lock"
      },
      "MARKS_FOLDER": {
        "value_type": "string",
        "value": "published"
      },
      "MAX_OUTPUT_BYTES": {
        "value_type": "positive_integer",
        "value": 26214400
      },
      "MAX_PIXELS": {
        "value_type": "positive_integer",
        "value": 80000000
      },
      "MAX_SOURCE_BYTES": {
        "value_type": "positive_integer",
        "value": 41943040
      },
      "PHOTO_BACKGROUND": {
        "value_type": "string",
        "value": "#ffffff"
      },
      "PHOTO_MAX_SIDE": {
        "value_type": "positive_integer",
        "value": 2000
      },
      "PHOTO_OPTIMIZE": {
        "value_type": "boolean",
        "value": true
      },
      "PHOTO_PROGRESSIVE": {
        "value_type": "boolean",
        "value": false
      },
      "PHOTO_QUALITY": {
        "value_type": "positive_integer",
        "value": 85
      },
      "PHOTO_SUBSAMPLING": {
        "value_type": "string",
        "value": "4:2:0"
      },
      "PLACEMENTS_FOLDER": {
        "value_type": "string",
        "value": "ledger"
      },
      "RECORD_FILE_SUFFIX": {
        "value_type": "string",
        "value": ".json"
      },
      "RECORD_MODE": {
        "value_type": "positive_integer",
        "value": 384
      },
      "REFUSAL_ANSWERS": {
        "value_type": "record_tuple",
        "row_model": "RefusalAnswerRule",
        "key": [
          "code"
        ],
        "total": true,
        "value": [
          {
            "code": "unauthorized",
            "status": 401,
            "detail": "the request does not carry the deliverer's token"
          },
          {
            "code": "invalid_request",
            "status": 422,
            "detail": "the project id or the body of the request has the wrong form"
          },
          {
            "code": "unknown_project",
            "status": 404,
            "detail": "the project has no object connection"
          },
          {
            "code": "connection_not_confirmed",
            "status": 409,
            "detail": "the owner has not confirmed the object's folders"
          },
          {
            "code": "folder_unavailable",
            "status": 503,
            "detail": "the object folders cannot be read"
          },
          {
            "code": "state_unavailable",
            "status": 503,
            "detail": "the delivery records cannot be read or written"
          },
          {
            "code": "invalid_source_id",
            "status": 422,
            "detail": "the source id has the wrong form"
          },
          {
            "code": "unsafe_reference",
            "status": 422,
            "detail": "the stored image would leave the binary store"
          },
          {
            "code": "not_placed",
            "status": 409,
            "detail": "the photo has not been delivered"
          },
          {
            "code": "publication_conflict",
            "status": 409,
            "detail": "the photo is already marked with another photo id"
          }
        ]
      },
      "SOURCE_ID_PATTERN": {
        "value_type": "string",
        "value": "[0-9a-f]{64}"
      },
      "STATE_FOLDER_MODE": {
        "value_type": "positive_integer",
        "value": 448
      },
      "STORED_IMAGE_MODE": {
        "value_type": "positive_integer",
        "value": 420
      },
      "STORE_FOLDER_MODE": {
        "value_type": "positive_integer",
        "value": 493
      },
      "TEMPORARY_FILE_MODE": {
        "value_type": "positive_integer",
        "value": 384
      },
      "TEMPORARY_NAME_PREFIX": {
        "value_type": "string",
        "value": ".tmp-"
      },
      "TOKEN_MIN_LENGTH": {
        "value_type": "positive_integer",
        "value": 32
      },
      "TOKEN_TRIM_CHARACTERS": {
        "value_type": "string",
        "value": " \t\n\r\u000b\f"
      }
    }
  }
}
