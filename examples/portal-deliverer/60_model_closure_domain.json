{
  "schema_version": "spec_workbench_model_closure.v1",
  "status": "closed",
  "models": {
    "ScanStatus": {
      "kind": "enum",
      "values": [
        "ready",
        "placed",
        "published",
        "rejected"
      ]
    },
    "ObservationReason": {
      "kind": "enum",
      "values": [
        "empty",
        "too_large",
        "not_a_regular_file",
        "unreadable_file",
        "unsupported_format"
      ]
    },
    "DateSource": {
      "kind": "enum",
      "values": [
        "exif",
        "file_modified"
      ]
    },
    "PlacementStatus": {
      "kind": "enum",
      "values": [
        "placed",
        "replayed",
        "failed"
      ]
    },
    "PlacementFailure": {
      "kind": "enum",
      "values": [
        "not_ready_or_absent",
        "source_changed",
        "empty",
        "unsupported_format",
        "too_many_pixels",
        "unreadable_image",
        "too_large",
        "not_a_regular_file",
        "unreadable_file"
      ]
    },
    "MarkStatus": {
      "kind": "enum",
      "values": [
        "marked",
        "replayed"
      ]
    },
    "RefusalCode": {
      "kind": "enum",
      "values": [
        "unauthorized",
        "invalid_request",
        "unknown_project",
        "connection_not_confirmed",
        "folder_unavailable",
        "state_unavailable",
        "invalid_source_id",
        "unsafe_reference",
        "not_placed",
        "publication_conflict"
      ]
    },
    "ObjectConnection": {
      "identity": "entity",
      "fields": {
        "project_id": "UUID",
        "label": "str",
        "root": "str",
        "photo_subfolder": "str",
        "invoice_subfolder": "str",
        "assignment_confirmed": "bool"
      }
    },
    "SourcePhotoObservation": {
      "identity": "value",
      "fields": {
        "name": "str",
        "size": "int",
        "source_id": "str | None",
        "status": "ScanStatus",
        "reason": "ObservationReason | None",
        "file_ref": "str | None",
        "photo_id": "UUID | None"
      }
    },
    "PreparedPhoto": {
      "identity": "value",
      "fields": {
        "content": "bytes",
        "taken_at": "datetime",
        "date_source": "DateSource"
      }
    },
    "PhotoPublication": {
      "identity": "value",
      "fields": {
        "intake_id": "str",
        "project_id": "UUID",
        "file_ref": "str",
        "photo_date": "datetime",
        "section_id": "UUID | None",
        "caption": "str | None",
        "client_visible": "bool",
        "intake_source": "str"
      }
    },
    "PhotoPlacement": {
      "identity": "entity",
      "fields": {
        "project_id": "UUID",
        "source_id": "str",
        "name": "str",
        "file_ref": "str",
        "sha256": "str",
        "size": "int",
        "media_type": "str",
        "date_source": "DateSource",
        "publication": "PhotoPublication"
      }
    },
    "PlacementOutcome": {
      "identity": "value",
      "fields": {
        "source_id": "str",
        "status": "PlacementStatus",
        "reason": "PlacementFailure | None",
        "placement": "PhotoPlacement | None",
        "photo_id": "UUID | None"
      }
    },
    "PublicationMark": {
      "identity": "entity",
      "fields": {
        "project_id": "UUID",
        "source_id": "str",
        "photo_id": "UUID",
        "marked_at": "datetime"
      }
    },
    "Refusal": {
      "identity": "value",
      "fields": {
        "code": "RefusalCode",
        "detail": "str"
      }
    }
  }
}
