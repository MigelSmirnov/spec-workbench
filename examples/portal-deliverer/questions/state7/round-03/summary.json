   ],
   "questions": [
    "Either observe_source_files must contractually guarantee a non-None source_id for READY sources, or _observation must handle a READY SourceFile whose source_id is None."
   ],
   "units": [
    "photo_delivery"
   ],
   "id": "photo_delivery:T2",
   "judgement": {
    "kind": "answered",
    "quotes": [
     "for a source whose status is the READY member, which observe_source_files always gives a source id, it MUST call read_placement and then read_mark for the project id and that source_id and return the PUBLISHED member of = models.ScanStatus with the file_ref of the placement and the photo_id of the mark when both exist, the PLACED member with that file_ref and no photo_id when only the placement exists, and the READY member with neither otherwise, letting their DelivererError pass."
    ],
    "later_state": null,
    "divergence": "",
    "why": "The note explicitly guarantees that observe_source_files supplies a source id for every READY source.",
    "verified": true,
    "blocking": false
   }
  }
