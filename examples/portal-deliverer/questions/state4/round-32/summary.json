   "questions": [
    "Which two-digit minute values make an EXIF offset usable: only 00 through 59, every 00 through 99 value admitted by EXIF_OFFSET_PATTERN, or some other set?"
   ],
   "units": [
    "context"
   ],
   "witnessed_by": [
