   "questions": [
    "For a protected route's trailing-slash path without an Authorization field, must the original request receive the path-first 307 specified here, or the UNAUTHORIZED refusal required by A5 rule 1 before its identifiers or body are examined?",
    "Does a trailing-slash request for a protected operation receive an unauthenticated 307 before A5 rule 1, or must a missing or invalid Authorization field produce the UNAUTHORIZED refusal before any redirect?",
    "Does a request for a protected route's trailing-slash path without exactly one valid Authorization field receive the 307 redirect, or must A5 rule 1 refuse it as unauthorized before redirect handling?"
   ],
   "units": [
    "?"
   ],
   "witnessed_by": [
