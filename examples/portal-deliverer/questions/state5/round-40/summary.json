 "topics": [
  {
   "topic": "Whether read_named_source opens a file before or only after name/path validation succeeds",
   "members": [
    "r1.00",
    "r2.00"
   ],
   "runs": [
    1,
    2
   ],
   "questions": [
    "When the requested name fails condition 1 of A3 rule 5, must read_named_source open no file as INV-02 requires, or must it still read one file once as its observable effect states?",
    "Does read_named_source read a file on every call, or only after the requested name and its path pass condition 1 of A3 rule 5?"
   ],
   "units": [
    "?",
    "context"
   ],
   "witnessed_by": [
    "r1.00",
    "r2.00"
   ],
   "id": "T1",
   "judgement": {
    "kind": "answered",
    "quotes": [
     "Nothing when the name fails condition 1 of A3 rule 5. Otherwise a `SourceRead`: one `SourceFile`, and the bytes that were judged when it is ready.",
     "Condition 1 of A3 rule 5, A1 orders 1 to 6, INV-01, INV-02 and INV-19.",
     "- INV-02: a delivery opens no path that fails condition 1 of A3 rule 5."
    ],
    "later_state": null,
    "divergence": "",
    "why": "The operation returns nothing and, by explicitly enforcing INV-02, opens no file when condition 1 fails; its one-file read applies only after that validation succeeds.",
    "verified": true,
    "witness": {
     "outcomes": [
      "",
      ""
     ]
    },
    "blocking": false,
    "provenance": [
     {
      "quote": "- INV-02: a delivery opens no path that fails condition 1 of A3 rule 5.",
      "state": 2,
      "document": "02_rules.md",
      "commit": "9f0f69faa1b15cf2bf2ab606de3270beaacd6df4",
      "date": "2026-11-18"
     }
    ]
   }
  },
  {
   "topic": "Whether mark_photo_published reads the clock when refused before source-id acceptance",
   "members": [
    "r2.01"
   ],
   "runs": [
    2
   ],
   "questions": [
    "Does every mark call read the clock once, or does a call refused before its source id is accepted read it zero times?"
   ],
   "units": [
    "context"
   ],
   "witnessed_by": [
    "r2.01"
   ],
   "id": "T2",
   "judgement": {
    "kind": "answered",
    "quotes": [
     "Reads the host clock at each call. `module:photo_delivery` calls it once per mark, after the source id is accepted (A7 rule 2).",
     "2. Only a mark reads it, once, after the token, the request form and the identifiers are accepted and\n   before the connection is examined or the project lock is taken. A mark refused before that point does\n   not read it. A mark refused after it, and a replayed mark, have read it and write nothing. Scan, delivery\n   and the health answer never read it."
    ],
    "later_state": null,
    "divergence": "",
    "why": "A call refused for a malformed source id reads the clock zero times because the clock is called only after the identifiers, including the source id, are accepted.",
    "verified": true,
    "witness": {
     "outcomes": [
      "",
      ""
     ]
    },
    "blocking": false,
    "provenance": [
     {
      "quote": "2. Only a mark reads it, once, after the token, the request form and the identifiers are accepted and before the connect",
      "state": 2,
      "document": "02_rules.md",
      "commit": "28252486ac61fcb13d6bd85b1679a4245887b88c",
      "date": "2026-11-18"
     }
    ]
   }
  }
 ],
