{
  "standard_version": 2,
  "default_module": "deliverer_service",
  "contracts": {
    "load_runtime_settings": "() -> RuntimeSettings",
    "_subfolder": "(value: object) -> str",
    "load_connections": "(path: Path) -> dict[UUID, ObjectConnection]",
    "confirmed_connection": "(connections_file: Path, project_id: UUID) -> ObjectConnection",
    "available_photo_folder": "(connection: ObjectConnection) -> Path",
    "_is_ignored": "(name: str) -> bool",
    "_opened_folder": "(path: Path) -> Iterator[int]",
    "_read_source_bytes": "(folder: int, entry: str) -> tuple[bytes, os.stat_result]",
    "_unlisted_folder": "(error: OSError) -> None",
    "_modified_at": "(info: os.stat_result) -> datetime",
    "_source_files": "(folder: int) -> Iterator[tuple[int, str, str, os.stat_result]]",
    "_observed": "(folder: int, entry: str, name: str, info: os.stat_result) -> tuple[SourceFile, bytes | None]",
    "observe_source_files": "(folder: Path) -> list[SourceFile]",
    "_name_parts": "(name: str) -> tuple[str, ...] | None",
    "read_named_source": "(folder: Path, name: str) -> SourceRead | None",
    "_to_naive_utc": "(moment: datetime) -> datetime",
    "_camera_offset": "(offset: object) -> timezone | None",
    "_parse_exif_moment": "(text: object, offset: object, zone: ZoneInfo, modified: datetime) -> datetime | None",
    "_photo_moment": "(image: Image.Image, modified: datetime, zone: ZoneInfo) -> tuple[datetime, DateSource]",
    "prepare_photo": "(raw: bytes, modified: datetime, timezone_name: str) -> PreparedPhoto",
    "build_publication": "(project_id: UUID, source_id: str, file_ref: str, photo: PreparedPhoto) -> PhotoPublication",
    "_sync_folder": "(folder: Path) -> None",
    "_make_folders": "(folder: Path, base: Path, mode: int, durable: bool) -> None",
    "_atomic_write": "(path: Path, base: Path, content: bytes, mode: int, folder_mode: int, durable_folder: bool) -> None",
    "_state_unavailable": "(error: Exception) -> DelivererError",
    "_read_record": "(path: Path, model: type[Record], project_id: UUID, source_id: str) -> Record | None",
    "_write_record": "(path: Path, base: Path, record: BaseModel) -> None",
    "_placement_path": "(context: DeliveryContext, project_id: UUID, source_id: str) -> Path",
    "_mark_path": "(context: DeliveryContext, project_id: UUID, source_id: str) -> Path",
    "_store_path": "(context: DeliveryContext, file_ref: str) -> Path",
    "project_lock": "(context: DeliveryContext, project_id: UUID) -> Iterator[None]",
    "store_image": "(context: DeliveryContext, project_id: UUID, source_id: str, content: bytes) -> str",
    "read_placement": "(context: DeliveryContext, project_id: UUID, source_id: str) -> PhotoPlacement | None",
    "write_placement": "(context: DeliveryContext, placement: PhotoPlacement) -> None",
    "read_mark": "(context: DeliveryContext, project_id: UUID, source_id: str) -> PublicationMark | None",
    "write_mark": "(context: DeliveryContext, mark: PublicationMark) -> None",
    "_require_source_id": "(source_id: str) -> None",
    "_photo_folder": "(context: DeliveryContext, project_id: UUID) -> Path",
    "_observation": "(context: DeliveryContext, project_id: UUID, source: SourceFile) -> SourcePhotoObservation",
    "scan_project_photos": "(context: DeliveryContext, project_id: UUID) -> ScanResult",
    "_failed": "(source_id: str, reason: PlacementFailure) -> PlacementOutcome",
    "_place": "(context: DeliveryContext, project_id: UUID, source_id: str, source: SourceFile, raw: bytes) -> PhotoPlacement",
    "deliver_project_photo": "(context: DeliveryContext, project_id: UUID, name: str, source_id: str) -> PlacementOutcome",
    "_mark_outcome": "(mark: PublicationMark, status: MarkStatus) -> MarkOutcome",
    "mark_photo_published": "(context: DeliveryContext, project_id: UUID, source_id: str, photo_id: UUID) -> MarkOutcome",
    "read_token": "(path: Path) -> str",
    "load_config": "(settings: RuntimeSettings) -> DeliveryContext",
    "run_service": "() -> int",
    "create_app": "(context: DeliveryContext, token: str) -> FastAPI",
    "extract_bearer_credential": "(request: Request) -> str",
    "health_handler": "(request: Request) -> HealthAnswer",
    "answer_health": "() -> HealthAnswer",
    "bearer_credential": "(request: Request) -> str",
    "check_token": "(token: str, credential: str) -> None",
    "_project_id": "(text: str) -> UUID",
    "_refusal_row": "(code: RefusalCode) -> RefusalAnswerRule",
    "_refusal_answer": "(code: RefusalCode) -> JSONResponse",
    "_deliver_request": "(body: bytes) -> DeliverRequest",
    "_published_request": "(body: bytes) -> PublishedRequest",
    "scan_route": "(request: Request, project_id: str) -> JSONResponse",
    "deliver_route": "(request: Request, project_id: str) -> JSONResponse",
    "mark_route": "(request: Request, project_id: str, source_id: str) -> JSONResponse",
    "utc_now": "() -> datetime"
  },
  "notes": [],
  "config": {
    "role": "data",
    "schema_version": 1,
    "deliverer": {
      "timezone": "Europe/Madrid",
      "port": 8850
    },
    "runtime_environment_variables": {
      "kind": "runtime_environment_variables",
      "schema": {
        "closed": true,
        "entry_fields": [
          "target",
          "value_type",
          "requiredness",
          "normalization",
          "default_when_absent",
          "accepted_values",
          "validation_reference"
        ],
        "value_types": [
          "string",
          "runtime_environment",
          "positive_integer"
        ],
        "requiredness_values": [
          "required",
          "optional"
        ],
        "normalization_values": [
          "none",
          "trim_lowercase",
          "base10_integer"
        ],
        "default_environments": [
          "development",
          "test",
          "production"
        ],
        "constraint_kinds": [
          "less_than_or_equal"
        ]
      },
      "variables": {
        "PORTAL_DELIVERER_TIMEZONE": {
          "target": "RuntimeSettings.timezone",
          "value_type": "string",
          "requiredness": "optional",
          "normalization": "none",
          "default_when_absent": {
            "development": "= config.deliverer.timezone",
            "test": "= config.deliverer.timezone",
            "production": "= config.deliverer.timezone"
          },
          "accepted_values": null,
          "validation_reference": null
        },
        "PORTAL_DELIVERER_BINARY_ROOT": {
          "target": "RuntimeSettings.binary_root",
          "value_type": "string",
          "requiredness": "required",
          "normalization": "none",
          "default_when_absent": {
            "development": null,
            "test": null,
            "production": null
          },
          "accepted_values": null,
          "validation_reference": null
        },
        "PORTAL_DELIVERER_STATE_DIR": {
          "target": "RuntimeSettings.state_dir",
          "value_type": "string",
          "requiredness": "required",
          "normalization": "none",
          "default_when_absent": {
            "development": null,
            "test": null,
            "production": null
          },
          "accepted_values": null,
          "validation_reference": null
        },
        "PORTAL_DELIVERER_CONNECTIONS_FILE": {
          "target": "RuntimeSettings.connections_file",
          "value_type": "string",
          "requiredness": "required",
          "normalization": "none",
          "default_when_absent": {
            "development": null,
            "test": null,
            "production": null
          },
          "accepted_values": null,
          "validation_reference": null
        },
        "PORTAL_DELIVERER_CREDENTIAL_FILE": {
          "target": "RuntimeSettings.credential_file",
          "value_type": "string",
          "requiredness": "required",
          "normalization": "none",
          "default_when_absent": {
            "development": null,
            "test": null,
            "production": null
          },
          "accepted_values": null,
          "validation_reference": null
        },
        "PORTAL_DELIVERER_PORT": {
          "target": "RuntimeSettings.port",
          "value_type": "positive_integer",
          "requiredness": "optional",
          "normalization": "base10_integer",
          "default_when_absent": {
            "development": "= config.deliverer.port",
            "test": "= config.deliverer.port",
            "production": "= config.deliverer.port"
          },
          "accepted_values": null,
          "validation_reference": null
        },
        "PORTAL_DELIVERER_ENVIRONMENT": {
          "target": "RuntimeSettings.environment",
          "value_type": "runtime_environment",
          "requiredness": "required",
          "normalization": "trim_lowercase",
          "default_when_absent": {
            "development": null,
            "test": null,
            "production": null
          },
          "accepted_values": "= models.RuntimeEnvironment",
          "validation_reference": "= models.RuntimeEnvironment"
        }
      },
      "constraints": []
    }
  },
  "models": {
    "RuntimeSettings": {
      "identity": "value",
      "fields": {
        "timezone": "str",
        "binary_root": "str",
        "state_dir": "str",
        "connections_file": "str",
        "credential_file": "str",
        "port": "int",
        "environment": "RuntimeEnvironment"
      }
    },
    "DeliveryContext": {
      "identity": "value",
      "fields": {
        "binary_root": "Path",
        "state_dir": "Path",
        "timezone": "str",
        "connections_file": "Path"
      }
    },
    "SourceFile": {
      "identity": "value",
      "fields": {
        "name": "str",
        "size": "int",
        "modified": "datetime",
        "status": "ScanStatus",
        "reason": "ObservationReason | None",
        "source_id": "str | None"
      }
    },
    "SourceRead": {
      "identity": "value",
      "fields": {
        "source": "SourceFile",
        "content": "bytes | None"
      }
    },
    "ScanResult": {
      "identity": "value",
      "fields": {
        "project_id": "UUID",
        "items": "list[SourcePhotoObservation]",
        "counts": "dict[ScanStatus, int]"
      }
    },
    "MarkOutcome": {
      "identity": "value",
      "fields": {
        "project_id": "UUID",
        "source_id": "str",
        "photo_id": "UUID",
        "marked_at": "datetime",
        "status": "MarkStatus"
      }
    },
    "HealthAnswer": {
      "identity": "value",
      "fields": {
        "status": "str"
      }
    },
    "DeliverRequest": {
      "identity": "value",
      "fields": {
        "name": "str",
        "source_id": "str"
      }
    },
    "PublishedRequest": {
      "identity": "value",
      "fields": {
        "photo_id": "UUID"
      }
    },
    "RefusalAnswerRule": {
      "identity": "value",
      "fields": {
        "code": "RefusalCode",
        "status": "int",
        "detail": "str"
      }
    },
    "ScanStatus": {
      "kind": "enum",
      "values": [
        "ready",
        "placed",
        "published",
        "rejected"
      ]
    },
    "ObservationReason": {
      "kind": "enum",
      "values": [
        "empty",
        "too_large",
        "not_a_regular_file",
        "unreadable_file",
        "unsupported_format"
      ]
    },
    "DateSource": {
      "kind": "enum",
      "values": [
        "exif",
        "file_modified"
      ]
    },
    "PlacementStatus": {
      "kind": "enum",
      "values": [
        "placed",
        "replayed",
        "failed"
      ]
    },
    "PlacementFailure": {
      "kind": "enum",
      "values": [
        "not_ready_or_absent",
        "source_changed",
        "empty",
        "unsupported_format",
        "too_many_pixels",
        "unreadable_image",
        "too_large",
        "not_a_regular_file",
        "unreadable_file"
      ]
    },
    "MarkStatus": {
      "kind": "enum",
      "values": [
        "marked",
        "replayed"
      ]
    },
    "RefusalCode": {
      "kind": "enum",
      "values": [
        "unauthorized",
        "invalid_request",
        "unknown_project",
        "connection_not_confirmed",
        "folder_unavailable",
        "state_unavailable",
        "invalid_source_id",
        "unsafe_reference",
        "not_placed",
        "publication_conflict"
      ]
    },
    "ObjectConnection": {
      "identity": "entity",
      "fields": {
        "project_id": "UUID",
        "label": "str",
        "root": "str",
        "photo_subfolder": "str",
        "invoice_subfolder": "str",
        "assignment_confirmed": "bool"
      }
    },
    "SourcePhotoObservation": {
      "identity": "value",
      "fields": {
        "name": "str",
        "size": "int",
        "source_id": "str | None",
        "status": "ScanStatus",
        "reason": "ObservationReason | None",
        "file_ref": "str | None",
        "photo_id": "UUID | None"
      }
    },
    "PreparedPhoto": {
      "identity": "value",
      "fields": {
        "content": "bytes",
        "taken_at": "datetime",
        "date_source": "DateSource"
      }
    },
    "PhotoPublication": {
      "identity": "value",
      "fields": {
        "intake_id": "str",
        "project_id": "UUID",
        "file_ref": "str",
        "photo_date": "datetime",
        "section_id": "UUID | None",
        "caption": "str | None",
        "client_visible": "bool",
        "intake_source": "str"
      }
    },
    "PhotoPlacement": {
      "identity": "entity",
      "fields": {
        "project_id": "UUID",
        "source_id": "str",
        "name": "str",
        "file_ref": "str",
        "sha256": "str",
        "size": "int",
        "media_type": "str",
        "date_source": "DateSource",
        "publication": "PhotoPublication"
      }
    },
    "PlacementOutcome": {
      "identity": "value",
      "fields": {
        "source_id": "str",
        "status": "PlacementStatus",
        "reason": "PlacementFailure | None",
        "placement": "PhotoPlacement | None",
        "photo_id": "UUID | None"
      }
    },
    "PublicationMark": {
      "identity": "entity",
      "fields": {
        "project_id": "UUID",
        "source_id": "str",
        "photo_id": "UUID",
        "marked_at": "datetime"
      }
    },
    "Refusal": {
      "identity": "value",
      "fields": {
        "code": "RefusalCode",
        "detail": "str"
      }
    },
    "RuntimeEnvironment": {
      "kind": "enum",
      "values": [
        "development",
        "test",
        "production"
      ]
    }
  },
  "rules": {
    "role": "data",
    "schema_version": 1,
    "data_provider_backend": {
      "kind": "data_provider_backend",
      "schema_version": 2,
      "backend": {
        "emitter": "python_constant_data_v1"
      },
      "wiring": {
        "module": "data_provider",
        "models_module": "portal_deliverer.models"
      },
      "constants": {
        "CONFLICT_COPY_MARK": {
          "value_type": "string",
          "value": ".sync-conflict-"
        },
        "IGNORED_NAME_PREFIXES": {
          "value_type": "string_tuple",
          "value": [
            ".",
            "~syncthing~"
          ]
        },
        "IGNORED_NAME_SUFFIXES": {
          "value_type": "string_tuple",
          "value": [
            ".tmp",
            "~"
          ]
        },
        "INTAKE_ID_PREFIX": {
          "value_type": "string",
          "value": "deliverer-photo-"
        },
        "INTAKE_SOURCE": {
          "value_type": "string",
          "value": "syncthing"
        },
        "LOCKS_FOLDER": {
          "value_type": "string",
          "value": "locks"
        },
        "LOCK_FILE_MODE": {
          "value_type": "positive_integer",
          "value": 384
        },
        "LOCK_FILE_SUFFIX": {
          "value_type": "string",
          "value": ".lock"
        },
        "MARKS_FOLDER": {
          "value_type": "string",
          "value": "published"
        },
        "MAX_OUTPUT_BYTES": {
          "value_type": "positive_integer",
          "value": 26214400
        },
        "MAX_PIXELS": {
          "value_type": "positive_integer",
          "value": 80000000
        },
        "MAX_SOURCE_BYTES": {
          "value_type": "positive_integer",
          "value": 41943040
        },
        "PHOTO_BACKGROUND": {
          "value_type": "string",
          "value": "#ffffff"
        },
        "PHOTO_MAX_SIDE": {
          "value_type": "positive_integer",
          "value": 2000
        },
        "PHOTO_OPTIMIZE": {
          "value_type": "boolean",
          "value": true
        },
        "PHOTO_PROGRESSIVE": {
          "value_type": "boolean",
          "value": false
        },
        "PHOTO_QUALITY": {
          "value_type": "positive_integer",
          "value": 85
        },
        "PHOTO_SUBSAMPLING": {
          "value_type": "string",
          "value": "4:2:0"
        },
        "PLACEMENTS_FOLDER": {
          "value_type": "string",
          "value": "ledger"
        },
        "RECORD_FILE_SUFFIX": {
          "value_type": "string",
          "value": ".json"
        },
        "RECORD_MODE": {
          "value_type": "positive_integer",
          "value": 384
        },
        "REFUSAL_ANSWERS": {
          "value_type": "record_tuple",
          "row_model": "RefusalAnswerRule",
          "key": [
            "code"
          ],
          "total": true,
          "value": [
            {
              "code": "unauthorized",
              "status": 401,
              "detail": "the request does not carry the deliverer's token"
            },
            {
              "code": "invalid_request",
              "status": 422,
              "detail": "the project id or the body of the request has the wrong form"
            },
            {
              "code": "unknown_project",
              "status": 404,
              "detail": "the project has no object connection"
            },
            {
              "code": "connection_not_confirmed",
              "status": 409,
              "detail": "the owner has not confirmed the object's folders"
            },
            {
              "code": "folder_unavailable",
              "status": 503,
              "detail": "the object folders cannot be read"
            },
            {
              "code": "state_unavailable",
              "status": 503,
              "detail": "the delivery records cannot be read or written"
            },
            {
              "code": "invalid_source_id",
              "status": 422,
              "detail": "the source id has the wrong form"
            },
            {
              "code": "unsafe_reference",
              "status": 422,
              "detail": "the stored image would leave the binary store"
            },
            {
              "code": "not_placed",
              "status": 409,
              "detail": "the photo has not been delivered"
            },
            {
              "code": "publication_conflict",
              "status": 409,
              "detail": "the photo is already marked with another photo id"
            }
          ]
        },
        "SOURCE_ID_PATTERN": {
          "value_type": "string",
          "value": "[0-9a-f]{64}"
        },
        "STATE_FOLDER_MODE": {
          "value_type": "positive_integer",
          "value": 448
        },
        "STORED_IMAGE_MODE": {
          "value_type": "positive_integer",
          "value": 420
        },
        "STORE_FOLDER_MODE": {
          "value_type": "positive_integer",
          "value": 493
        },
        "TEMPORARY_FILE_MODE": {
          "value_type": "positive_integer",
          "value": 384
        },
        "TEMPORARY_NAME_PREFIX": {
          "value_type": "string",
          "value": ".tmp-"
        },
        "TOKEN_MIN_LENGTH": {
          "value_type": "positive_integer",
          "value": 32
        },
        "TOKEN_TRIM_CHARACTERS": {
          "value_type": "string",
          "value": " \t\n\r\u000b\f"
        }
      }
    },
    "system_clock_backend": {
      "kind": "system_clock_backend",
      "schema_version": 4,
      "backend": {
        "emitter": "python_host_naive_utc_clock_v1"
      },
      "wiring": {
        "module": "system_clock",
        "function": "utc_now"
      },
      "time": {
        "policy": "rules.time_source_policy",
        "read": "per_call",
        "representation": "naive_utc_datetime"
      }
    },
    "http_router_backend": {
      "kind": "http_router_backend",
      "schema_version": 1,
      "backend": {
        "framework": "fastapi",
        "emitter": "fastapi_sync_v1"
      },
      "wiring": {
        "module": "deliverer_router",
        "app_factory": "create_app",
        "request_parameter": "request",
        "state_bindings": {
          "context": {
            "factory_parameter": "context",
            "state_attribute": "context"
          },
          "token": {
            "factory_parameter": "token",
            "state_attribute": "token"
          }
        },
        "credential_extractors": {
          "bearer": {
            "kind": "header_scheme",
            "function": "extract_bearer_credential",
            "header": "Authorization",
            "scheme": "Bearer",
            "reject_with": "AuthenticationRequired"
          }
        }
      },
      "principals": {},
      "auth_policies": {
        "bearer": {
          "principal": null
        },
        "none": {
          "principal": null
        }
      },
      "projections": [],
      "routes": [
        {
          "handler": "health_handler",
          "method": "GET",
          "path": "/health",
          "auth": "none",
          "success_status": 200,
          "response_mode": "json",
          "emission": "table",
          "authorize": [],
          "delegate": {
            "function": "answer_health",
            "args": []
          },
          "projection": null,
          "returns": "delegate"
        },
        {
          "handler": "scan_route",
          "method": "GET",
          "path": "/v1/projects/{project_id}/photos",
          "auth": "bearer",
          "success_status": 200,
          "response_mode": "json",
          "emission": "irregular",
          "irregular_reason": "http_router_backend/v1 answers every mapped exception with an empty body, while every refusal of this route is an M08 body with code and detail that the calling agent reads its failure reason from; the canonical handler in deliverer_api owns only turning a DelivererError into that M08 answer and delegates every decision to photo_delivery.scan_project_photos"
        },
        {
          "handler": "deliver_route",
          "method": "POST",
          "path": "/v1/projects/{project_id}/photos/deliver",
          "auth": "bearer",
          "success_status": 200,
          "response_mode": "json",
          "emission": "irregular",
          "irregular_reason": "http_router_backend/v1 answers every mapped exception with an empty body, while every refusal of this route is an M08 body with code and detail that the calling agent reads its failure reason from; the canonical handler in deliverer_api owns only turning a DelivererError into that M08 answer and delegates every decision to photo_delivery.deliver_project_photo"
        },
        {
          "handler": "mark_route",
          "method": "POST",
          "path": "/v1/projects/{project_id}/photos/{source_id}/published",
          "auth": "bearer",
          "success_status": 200,
          "response_mode": "json",
          "emission": "irregular",
          "irregular_reason": "http_router_backend/v1 answers every mapped exception with an empty body, while every refusal of this route is an M08 body with code and detail that the calling agent reads its failure reason from; the canonical handler in deliverer_api owns only turning a DelivererError into that M08 answer and delegates every decision to photo_delivery.mark_photo_published"
        }
      ],
      "error_policy": {
        "body": "empty",
        "default_status": 500,
        "mapping": [
          {
            "exception": "AuthenticationRequired",
            "status": 401
          }
        ],
        "unavailable_to_module": []
      },
      "irregular_ownership": {
        "module": "deliverer_api"
      }
    },
    "time_source_policy": {
      "kind": "time_source_policy",
      "schema_version": 1,
      "wall_clock": {
        "authority_modules": [
          "system_clock"
        ],
        "allowed_primitives": [
          "datetime.datetime.now"
        ],
        "single_host_source": true,
        "samples_per_read": 1
      }
    }
  },
  "implementation_obligations": {},
