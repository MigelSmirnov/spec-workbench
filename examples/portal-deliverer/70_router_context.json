{
  "schema_version": "spec_workbench_router_context.v1",
  "status": "closed",
  "backend": {
    "framework": "fastapi",
    "emitter": "fastapi_sync_v1"
  },
  "wiring": {
    "module": "deliverer_router",
    "app_factory": "create_app",
    "request_parameter": "request",
    "state_bindings": {
      "context": {
        "factory_parameter": "context",
        "state_attribute": "context"
      },
      "token": {
        "factory_parameter": "token",
        "state_attribute": "token"
      }
    },
    "credential_extractors": {
      "bearer": {
        "kind": "header_scheme",
        "function": "extract_bearer_credential",
        "header": "Authorization",
        "scheme": "Bearer",
        "reject_with": "AuthenticationRequired"
      }
    }
  },
  "principals": {
    "owner": {
      "resolver": "check_token",
      "args": [
        {
          "ref": "slot",
          "name": "token"
        },
        {
          "ref": "credential",
          "name": "bearer"
        }
      ]
    }
  },
  "auth_policies": {
    "bearer": {
      "principal": "owner"
    },
    "none": {
      "principal": null
    }
  },
  "projections": [],
  "error_policy": {
    "body": "empty",
    "default_status": 500,
    "mapping": [
      {
        "exception": "AuthenticationRequired",
        "status": 401
      }
    ],
    "unavailable_to_module": []
  },
  "unresolved": []
}
