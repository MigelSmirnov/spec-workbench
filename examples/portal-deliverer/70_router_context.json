{
  "schema_version": "spec_workbench_router_context.v1",
  "status": "closed",
  "backend": {
    "framework": "fastapi",
    "emitter": "fastapi_sync_v2"
  },
  "wiring": {
    "module": "deliverer_router",
    "app_factory": "create_app",
    "request_parameter": "request",
    "state_bindings": {
      "token": {
        "factory_parameter": "token",
        "state_attribute": "token"
      },
      "delivery": {
        "factory_parameter": "context",
        "state_attribute": "context"
      }
    },
    "credential_extractors": {
      "bearer": {
        "kind": "header_scheme",
        "function": "extract_bearer_credential",
        "header": "Authorization",
        "scheme": "Bearer",
        "reject_with": "AuthenticationRequired"
      }
    }
  },
  "principals": {},
  "auth_policies": {
    "bearer": {
      "principal": null
    },
    "none": {
      "principal": null
    }
  },
  "projections": [],
  "error_policy": {
    "body": "answer",
    "default_status": 500,
    "mapping": [
      {
        "exception": "AuthenticationRequired",
        "answer": {
          "function": "refusal_answer",
          "args": [
            {
              "ref": "enum",
              "type": "RefusalCode",
              "member": "UNAUTHORIZED"
            }
          ]
        }
      },
      {
        "exception": "DelivererError",
        "answer": {
          "function": "refusal_answer",
          "args": [
            {
              "ref": "exception",
              "path": [
                "code"
              ]
            }
          ]
        }
      }
    ],
    "request_validation": {
      "function": "refusal_answer",
      "args": [
        {
          "ref": "enum",
          "type": "RefusalCode",
          "member": "INVALID_REQUEST"
        }
      ]
    },
    "unavailable_to_module": []
  },
  "unresolved": []
}
