{
  "schema_version": "spec_workbench_state4_plan.v1",
  "flows": [
    {
      "key": "flow:service_start",
      "purpose": "Start the service only with valid settings, a valid connections file and a protected token.",
      "required_modules": [
        "module:object_connections",
        "module:runtime_settings",
        "module:deliverer_router",
        "module:deliverer_service"
      ],
      "candidate_capabilities": [
        "capability:runtime_settings.load_runtime_settings",
        "capability:deliverer_service.load_config",
        "capability:deliverer_service.read_token",
        "capability:deliverer_router.create_app",
        "capability:object_connections.load_connections",
        "capability:deliverer_service.run_service"
      ]
    },
    {
      "key": "flow:answer_health",
      "purpose": "Tell the deployment that the service is listening, without a token and without any project data.",
      "required_modules": [
        "module:deliverer_router",
        "module:deliverer_api"
      ],
      "candidate_capabilities": [
        "capability:deliverer_router.create_app",
        "capability:deliverer_api.answer_health"
      ]
    },
    {
      "key": "flow:scan_project_photos",
      "purpose": "Report what a confirmed project's photo folder holds and what was already delivered, without writing anything.",
      "required_modules": [
        "module:deliverer_api",
        "module:photo_delivery",
        "module:object_connections",
        "module:source_folder",
        "module:delivery_store",
        "module:deliverer_router"
      ],
      "candidate_capabilities": [
        "capability:deliverer_router.create_app",
        "capability:deliverer_api.scan_route",
        "capability:photo_delivery.scan_project_photos",
        "capability:object_connections.confirmed_connection",
        "capability:object_connections.available_photo_folder",
        "capability:source_folder.observe_source_files",
        "capability:delivery_store.read_placement",
        "capability:delivery_store.read_mark"
      ]
    },
    {
      "key": "flow:deliver_one_photo",
      "purpose": "Place one named photo in the Portal store, or return the first result, or say why it cannot be delivered.",
      "required_modules": [
        "module:deliverer_api",
        "module:photo_delivery",
        "module:object_connections",
        "module:source_folder",
        "module:photo_preparation",
        "module:delivery_store",
        "module:deliverer_router"
      ],
      "candidate_capabilities": [
        "capability:deliverer_router.create_app",
        "capability:deliverer_api.deliver_route",
        "capability:photo_delivery.deliver_project_photo",
        "capability:object_connections.confirmed_connection",
        "capability:object_connections.available_photo_folder",
        "capability:delivery_store.project_lock",
        "capability:delivery_store.read_placement",
        "capability:delivery_store.read_mark",
        "capability:source_folder.read_named_source",
        "capability:photo_preparation.prepare_photo",
        "capability:delivery_store.store_image",
        "capability:photo_preparation.build_publication",
        "capability:delivery_store.write_placement"
      ]
    },
    {
      "key": "flow:record_publication",
      "purpose": "Remember once which Portal photo a delivered source became.",
      "required_modules": [
        "module:deliverer_api",
        "module:photo_delivery",
        "module:system_clock",
        "module:object_connections",
        "module:delivery_store",
        "module:deliverer_router"
      ],
      "candidate_capabilities": [
        "capability:deliverer_router.create_app",
        "capability:deliverer_api.mark_route",
        "capability:photo_delivery.mark_photo_published",
        "capability:system_clock.utc_now",
        "capability:object_connections.confirmed_connection",
        "capability:delivery_store.project_lock",
        "capability:delivery_store.read_placement",
        "capability:delivery_store.read_mark",
        "capability:delivery_store.write_mark"
      ]
    },
    {
      "key": "flow:owner_delivery",
      "purpose": "Bring the photos the owner chose from the folder to the Portal, hidden, with a result for each photo.",
      "required_modules": [
        "module:deliverer_api",
        "module:photo_delivery",
        "module:deliverer_router"
      ],
      "candidate_capabilities": [
        "capability:photo_delivery.scan_project_photos",
        "capability:photo_delivery.deliver_project_photo",
        "capability:photo_delivery.mark_photo_published"
      ]
    }
  ]
}
