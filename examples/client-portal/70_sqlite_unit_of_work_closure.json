{
  "schema_version": "spec_workbench_sqlite_unit_of_work_backend_closure.v1",
  "status": "closed",
  "backend_ir": {
    "kind": "sqlite_unit_of_work_backend",
    "schema_version": 1,
    "backend": {
      "emitter": "python_sqlite_unit_of_work_v1"
    },
    "wiring": {
      "module": "portal_store",
      "models_module": "core.models",
      "error_class": "PersistenceError",
      "store_class": "PortalStore",
      "transaction_class": "PortalTransaction",
      "context_interface": "AuditRepositoryContext"
    },
    "accessors": [
      {
        "accessor": "audit",
        "repository": "SqliteAuditRepository"
      },
      {
        "accessor": "project_tracking",
        "repository": "SqliteProjectTrackingRepository"
      },
      {
        "accessor": "project_sections",
        "repository": "SqliteProjectSectionRepository"
      },
      {
        "accessor": "budgets",
        "repository": "SqliteBudgetRepository"
      },
      {
        "accessor": "snapshot_imports",
        "repository": "SqliteSnapshotImportRepository"
      },
      {
        "accessor": "expenses",
        "repository": "SqliteExpenseRepository"
      },
      {
        "accessor": "progress_photos",
        "repository": "SqliteProgressPhotoRepository"
      },
      {
        "accessor": "staff_access",
        "repository": "SqliteStaffAccessRepository"
      },
      {
        "accessor": "viewer_access",
        "repository": "SqliteViewerAccessRepository"
      },
      {
        "accessor": "service_identity",
        "repository": "SqliteServiceIdentityRepository"
      }
    ],
    "transaction": {
      "connection": "one_per_begin",
      "schema": "create_on_begin_in_accessor_order",
      "close": "exactly_once",
      "commit_failure": "rollback_then_close",
      "use_after_close": "raise_error_class",
      "error_translation": "every_exception_to_error_class"
    },
    "bootstrap_store": {
      "module": "staff_bootstrap_store",
      "class": "SqliteStaffBootstrapStore",
      "port": "StaffBootstrapPort",
      "operation": "create_if_empty",
      "guard_table": {
        "ref": "config",
        "path": [
          "persistence",
          "staff_account_table_name"
        ]
      },
      "writes": [
        {
          "parameter": "account",
          "repository": "SqliteStaffAccessRepository",
          "method": "insert_staff_account"
        },
        {
          "parameter": "audit",
          "repository": "SqliteAuditRepository",
          "method": "insert_audit"
        }
      ],
      "transaction": {
        "begin": "exclusive",
        "driver_autocommit": "disabled",
        "schema": "create_for_written_repositories",
        "when_not_empty": "rollback_and_return_false",
        "close": "exactly_once",
        "error_translation": "sqlite_database_error_to_error_class"
      }
    }
  }
}
