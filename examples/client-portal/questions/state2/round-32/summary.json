    "precedent": {
     "id": "P10",
     "round": "round-29",
     "topic": "REGISTRY_BASE_URL startup versus per-call configuration lifecycle",
     "kind": "answered",
     "quotes": [
      "`REGISTRY_BASE_URL` is read by the Registry gateway at each call, not at start-up: it is no required start-up variable, and its absence fails only Registry calls (A6)."
     ],
     "why": "A30 explicitly excludes REGISTRY_BASE_URL from startup configuration and validation and requires the gateway to read it for each call."
