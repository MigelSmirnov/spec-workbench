 "topics": [
  {
   "topic": "Whether failed or refused significant operations must create exactly one rejected AuditRecord",
   "members": [
    "r1.00",
    "r3.00"
   ],
   "runs": [
    1,
    3
   ],
   "questions": [
    "When grant or assignment creation is refused by Registry validation because the project is unknown or archived, is a rejected AuditRecord created, or is the attempt recorded nowhere?",
    "When a catalogued significant operation fails because Registry or storage fails before the business operation completes, is no AuditRecord created, or must exactly one rejected AuditRecord be created?"
   ],
   "units": [
    "context"
   ],
   "witnessed_by": [
    "r1.00",
    "r3.00"
   ],
   "id": "T1",
   "judgement": {
    "kind": "answered_later",
    "quotes": [
     "In the running service exactly two actions write a rejected record:\n`snapshot.import`, for every classified attempt that is not accepted or a\nreplay (R0-25: an attempt the import route refuses on access is not\nclassified and writes nothing, Q20), with `reason_code` equal to its `ImportRejectReason` value\nor, for an integrity conflict, `integrity_conflict`; and `staff.login_failed`,\nnon-significant, with no `reason_code`. Every other refused operation\nrolls its transaction back and writes no record."
    ],
    "later_state": 2,
    "divergence": "",
    "why": "State 2 decides that Registry-validation refusals, Registry failures, storage failures, and all other refused operations except classified snapshot imports and failed staff logins write no AuditRecord.",
    "verified": true,
    "witness": {
     "outcomes": [
      "",
      ""
     ]
    },
    "blocking": false
   }
  }
 ],
