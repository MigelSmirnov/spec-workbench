{
  "schema_version": "spec_workbench_router_context.v1",
  "status": "closed",
  "backend": {
    "framework": "fastapi",
    "emitter": "fastapi_sync_v1"
  },
  "wiring": {
    "module": "api",
    "app_factory": "create_app",
    "request_parameter": "request",
    "state_bindings": {
      "store": {
        "factory_parameter": "store",
        "state_attribute": "portal_store"
      }
    },
    "credential_extractors": {
      "bearer": {
        "kind": "header_scheme",
        "function": "_bearer_token",
        "header": "Authorization",
        "scheme": "Bearer",
        "reject_with": "AuthenticationRejected"
      }
    }
  },
  "principals": {
    "service": {
      "resolver": "authenticate_service_principal",
      "args": [
        {
          "ref": "slot",
          "name": "store"
        },
        {
          "ref": "credential",
          "name": "bearer"
        }
      ]
    },
    "staff": {
      "resolver": "resolve_staff_session",
      "args": [
        {
          "ref": "slot",
          "name": "store"
        },
        {
          "ref": "credential",
          "name": "bearer"
        }
      ]
    }
  },
  "auth_policies": {
    "administrator_bearer": {
      "principal": "staff"
    },
    "public": {
      "principal": null
    },
    "service_bearer": {
      "principal": "service"
    },
    "staff_bearer": {
      "principal": "staff"
    },
    "viewer_cookie": {
      "principal": null
    }
  },
  "projections": [
    {
      "function": "_document_mutation_result",
      "fields": [
        {
          "field": "document_id",
          "value": {
            "ref": "parameter",
            "path": [
              "document",
              "document_id"
            ]
          }
        },
        {
          "field": "client_visible",
          "value": {
            "ref": "parameter",
            "path": [
              "document",
              "client_visible"
            ]
          }
        },
        {
          "field": "updated_at",
          "value": {
            "ref": "parameter",
            "path": [
              "document",
              "updated_at"
            ]
          }
        }
      ]
    },
    {
      "function": "_expense_mutation_result",
      "fields": [
        {
          "field": "expense_id",
          "value": {
            "ref": "parameter",
            "path": [
              "outcome",
              "aggregate",
              "expense",
              "expense_id"
            ]
          }
        },
        {
          "field": "document_id",
          "value": {
            "ref": "parameter",
            "path": [
              "outcome",
              "aggregate",
              "document",
              "document_id"
            ]
          }
        },
        {
          "field": "replayed",
          "value": {
            "ref": "parameter",
            "path": [
              "outcome",
              "replayed"
            ]
          }
        }
      ]
    },
    {
      "function": "_service_credential_response",
      "fields": [
        {
          "field": "credential_id",
          "value": {
            "ref": "parameter",
            "path": [
              "issue",
              "credential",
              "credential_id"
            ]
          }
        },
        {
          "field": "service_principal_id",
          "value": {
            "ref": "parameter",
            "path": [
              "issue",
              "credential",
              "service_principal_id"
            ]
          }
        },
        {
          "field": "key_version",
          "value": {
            "ref": "parameter",
            "path": [
              "issue",
              "credential",
              "key_version"
            ]
          }
        },
        {
          "field": "secret",
          "value": {
            "ref": "parameter",
            "path": [
              "issue",
              "secret"
            ]
          }
        },
        {
          "field": "created_at",
          "value": {
            "ref": "parameter",
            "path": [
              "issue",
              "credential",
              "created_at"
            ]
          }
        },
        {
          "field": "expires_at",
          "value": {
            "ref": "parameter",
            "path": [
              "issue",
              "credential",
              "expires_at"
            ]
          }
        }
      ]
    },
    {
      "function": "_service_principal_view",
      "fields": [
        {
          "field": "service_principal_id",
          "value": {
            "ref": "parameter",
            "path": [
              "principal",
              "service_principal_id"
            ]
          }
        },
        {
          "field": "name",
          "value": {
            "ref": "parameter",
            "path": [
              "principal",
              "name"
            ]
          }
        },
        {
          "field": "source_type",
          "value": {
            "ref": "parameter",
            "path": [
              "principal",
              "source_type"
            ]
          }
        },
        {
          "field": "status",
          "value": {
            "ref": "parameter",
            "path": [
              "principal",
              "status"
            ]
          }
        },
        {
          "field": "scope_mode",
          "value": {
            "ref": "parameter",
            "path": [
              "principal",
              "scope_mode"
            ]
          }
        },
        {
          "field": "created_at",
          "value": {
            "ref": "parameter",
            "path": [
              "principal",
              "created_at"
            ]
          }
        },
        {
          "field": "disabled_at",
          "value": {
            "ref": "parameter",
            "path": [
              "principal",
              "disabled_at"
            ]
          }
        }
      ]
    },
    {
      "function": "_viewer_credential_response",
      "fields": [
        {
          "field": "credential_id",
          "value": {
            "ref": "parameter",
            "path": [
              "issue",
              "credential",
              "credential_id"
            ]
          }
        },
        {
          "field": "viewer_id",
          "value": {
            "ref": "parameter",
            "path": [
              "issue",
              "credential",
              "viewer_id"
            ]
          }
        },
        {
          "field": "secret",
          "value": {
            "ref": "parameter",
            "path": [
              "issue",
              "secret"
            ]
          }
        },
        {
          "field": "created_at",
          "value": {
            "ref": "parameter",
            "path": [
              "issue",
              "credential",
              "created_at"
            ]
          }
        }
      ]
    },
    {
      "function": "_viewer_view",
      "fields": [
        {
          "field": "viewer_id",
          "value": {
            "ref": "parameter",
            "path": [
              "viewer",
              "viewer_id"
            ]
          }
        },
        {
          "field": "display_name",
          "value": {
            "ref": "parameter",
            "path": [
              "viewer",
              "display_name"
            ]
          }
        },
        {
          "field": "status",
          "value": {
            "ref": "parameter",
            "path": [
              "viewer",
              "status"
            ]
          }
        },
        {
          "field": "created_at",
          "value": {
            "ref": "parameter",
            "path": [
              "viewer",
              "created_at"
            ]
          }
        },
        {
          "field": "revoked_at",
          "value": {
            "ref": "parameter",
            "path": [
              "viewer",
              "revoked_at"
            ]
          }
        }
      ]
    }
  ],
  "error_policy": {
    "body": "empty",
    "default_status": 500,
    "mapping": [
      {
        "exception": "AuthenticationRejected",
        "status": 401
      },
      {
        "exception": "AuthorizationRejected",
        "status": 403
      },
      {
        "exception": "ScopedNotFoundError",
        "status": 404
      },
      {
        "exception": "BinaryAccessRejected",
        "status": 404
      },
      {
        "exception": "ArchivedProjectRejected",
        "status": 409
      },
      {
        "exception": "IdentityInputRejected",
        "status": 422
      },
      {
        "exception": "BudgetValidationError",
        "status": 422
      },
      {
        "exception": "ExpenseValidationError",
        "status": 422
      },
      {
        "exception": "PhotoValidationError",
        "status": 422
      },
      {
        "exception": "TrackingValidationError",
        "status": 422
      },
      {
        "exception": "FinancialValidationError",
        "status": 422
      },
      {
        "exception": "BudgetConflictError",
        "status": 409
      },
      {
        "exception": "ExpenseConflictError",
        "status": 409
      },
      {
        "exception": "PhotoConflictError",
        "status": 409
      },
      {
        "exception": "TrackingConflictError",
        "status": 409
      },
      {
        "exception": "ChallengeRejected",
        "status": 400
      },
      {
        "exception": "ChallengeRateLimited",
        "status": 429
      },
      {
        "exception": "RegistryBoundaryError",
        "status": 502
      },
      {
        "exception": "EmailDeliveryError",
        "status": 502
      },
      {
        "exception": "PersistenceError",
        "status": 500
      },
      {
        "exception": "BinaryStorageError",
        "status": 500
      }
    ],
    "unavailable_to_module": [
      "BinaryStorageError",
      "EmailDeliveryError"
    ]
  },
  "unresolved": []
}
