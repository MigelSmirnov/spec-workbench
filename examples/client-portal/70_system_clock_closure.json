{
  "schema_version": "spec_workbench_system_clock_backend_closure.v1",
  "status": "closed",
  "backend_ir": {
    "kind": "system_clock_backend",
    "schema_version": 5,
    "backend": {
      "emitter": "python_host_naive_utc_and_elapsed_clock_v1"
    },
    "wiring": {
      "module": "system_clock",
      "wall_clock_function": "utc_now",
      "elapsed_clock_function": "monotonic_seconds"
    },
    "time": {
      "policy": "rules.time_source_policy",
      "read": "per_call",
      "representation": "naive_utc_datetime"
    }
  }
}
