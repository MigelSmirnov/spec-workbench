{
  "schema_version": "spec_workbench_model_closure.v1",
  "status": "closed",
  "models": {
    "ProjectStatus": {
      "kind": "enum",
      "values": [
        "active",
        "archived"
      ]
    },
    "CustomerKind": {
      "kind": "enum",
      "values": [
        "person",
        "company"
      ]
    },
    "ObjectKind": {
      "kind": "enum",
      "values": [
        "apartment",
        "house",
        "commercial",
        "other"
      ]
    },
    "CustomerLanguage": {
      "kind": "enum",
      "values": [
        "es",
        "ru",
        "en"
      ]
    },
    "PointerStatus": {
      "kind": "enum",
      "values": [
        "published",
        "superseded",
        "withdrawn"
      ]
    },
    "PrincipalKind": {
      "kind": "enum",
      "values": [
        "owner",
        "service",
        "agent_via_kernel"
      ]
    },
    "DisclosureClass": {
      "kind": "enum",
      "values": [
        "open",
        "business_confidential",
        "personal_data"
      ]
    },
    "ServiceName": {
      "kind": "enum",
      "values": [
        "presupro",
        "client_portal",
        "cabinet",
        "cabinet_kernel"
      ]
    },
    "ServiceOperation": {
      "kind": "enum",
      "values": [
        "validate_project_reference",
        "read_project_context",
        "read_customer_billing",
        "list_artifacts",
        "read_latest_artifact",
        "read_project",
        "list_rooms",
        "list_projects",
        "register_agent_session",
        "end_agent_session",
        "read_session_access",
        "request_project_access",
        "read_agent_projection",
        "add_room",
        "publish_artifact_pointer",
        "withdraw_artifact_pointer"
      ]
    },
    "AuditAction": {
      "kind": "enum",
      "values": [
        "project_created",
        "project_corrected",
        "project_archived",
        "project_anonymised",
        "project_deleted",
        "customer_recorded",
        "customer_corrected",
        "customer_erased",
        "customer_restricted",
        "customer_restriction_lifted",
        "customer_relationship_ended",
        "customer_relationship_resumed",
        "session_project_granted",
        "session_project_revoked",
        "import_accepted",
        "audit_entries_erased"
      ]
    },
    "AuditOutcome": {
      "kind": "enum",
      "values": [
        "accepted"
      ]
    },
    "AuditSubjectKind": {
      "kind": "enum",
      "values": [
        "project",
        "customer",
        "session_project",
        "import",
        "none"
      ]
    },
    "ConfirmedAction": {
      "kind": "enum",
      "values": [
        "archive_project",
        "erase_project",
        "confirm_import",
        "erase_audit_entries"
      ]
    },
    "ArtifactTypeOwner": {
      "identity": "value",
      "fields": {
        "artifact_type": "str",
        "owner_service": "ServiceName"
      }
    },
    "ServiceRight": {
      "identity": "value",
      "fields": {
        "service": "ServiceName",
        "operation": "ServiceOperation"
      }
    },
    "ServiceHighestClass": {
      "identity": "value",
      "fields": {
        "service": "ServiceName",
        "highest_class": "DisclosureClass"
      }
    },
    "PersonalDataField": {
      "identity": "value",
      "fields": {
        "answer_model": "str",
        "field": "str"
      }
    },
    "RefusalHttpStatus": {
      "identity": "value",
      "fields": {
        "code": "RefusalCode",
        "status": "int"
      }
    },
    "OwnerActionRoute": {
      "identity": "value",
      "fields": {
        "action": "OwnerAction",
        "method": "str",
        "path": "str",
        "is_change": "bool",
        "touches_upload": "bool"
      }
    },
    "OwnerAuditAction": {
      "identity": "value",
      "fields": {
        "action": "OwnerAction",
        "transition": "CustomerTransition | None",
        "erasure": "ProjectErasure | None",
        "audit_action": "AuditAction",
        "subject_kind": "AuditSubjectKind"
      }
    },
    "Project": {
      "identity": "entity",
      "fields": {
        "project_id": "str",
        "display_name": "str | None",
        "alias": "str | None",
        "object_facts": "Object | None",
        "customer_ref": "str | None",
        "status": "ProjectStatus",
        "revision": "int | None",
        "created_at": "datetime | None",
        "last_changed_at": "datetime | None",
        "create_request_id": "str | None",
        "archived_at": "datetime | None",
        "anonymised": "bool"
      }
    },
    "Object": {
      "identity": "value",
      "fields": {
        "address": "str",
        "object_kind": "ObjectKind | None",
        "floor_area_m2": "Decimal | None",
        "rooms_count": "int | None",
        "floor": "int | None"
      }
    },
    "Room": {
      "identity": "entity",
      "fields": {
        "room_id": "str",
        "project_id": "str",
        "name": "str",
        "added_at": "datetime",
        "create_request_id": "str | None"
      }
    },
    "Customer": {
      "identity": "entity",
      "fields": {
        "customer_ref": "str",
        "customer_kind": "CustomerKind | None",
        "name": "str | None",
        "phone": "str | None",
        "email": "str | None",
        "language": "CustomerLanguage | None",
        "tax_id": "str | None",
        "legal_name": "str | None",
        "revision": "int | None",
        "created_at": "datetime | None",
        "last_changed_at": "datetime | None",
        "create_request_id": "str | None",
        "restricted_at": "datetime | None",
        "relationship_ended_at": "datetime | None",
        "relationship_ended_on": "date | None",
        "erased_at": "datetime | None"
      }
    },
    "ArtifactPointer": {
      "identity": "entity",
      "fields": {
        "pointer_id": "str",
        "project_id": "str",
        "artifact_type": "str",
        "owner_service": "ServiceName",
        "version": "int",
        "uri": "str | None",
        "payload_ref": "str | None",
        "content_digest": "str | None",
        "status": "PointerStatus",
        "published_at": "datetime",
        "publisher": "PointerPublisher",
        "create_request_id": "str | None",
        "superseded_at": "datetime | None",
        "withdrawn_at": "datetime | None",
        "withdrawn_by": "ActingPrincipal | None"
      }
    },
    "PointerPublisher": {
      "kind": "discriminated_union",
      "discriminator": "publisher_kind",
      "variants": [
        "PrincipalPublisher",
        "ImportPublisher"
      ]
    },
    "PrincipalPublisher": {
      "identity": "value",
      "fields": {
        "publisher_kind": "Literal['principal']",
        "principal": "ActingPrincipal"
      }
    },
    "ImportPublisher": {
      "identity": "value",
      "fields": {
        "publisher_kind": "Literal['import']",
        "file_digest": "str"
      }
    },
    "AgentSession": {
      "identity": "entity",
      "fields": {
        "session_id": "str",
        "granted_project_ids": "tuple[str, ...]",
        "active_project_id": "str | None",
        "pending_request": "AccessRequest | None",
        "access_version": "int",
        "registered_at": "datetime"
      }
    },
    "ActingPrincipal": {
      "identity": "value",
      "fields": {
        "principal_kind": "PrincipalKind",
        "service": "ServiceName | None",
        "session_id": "str | None"
      }
    },
    "AccessRequest": {
      "identity": "value",
      "fields": {
        "text": "str",
        "made_at": "datetime"
      }
    },
    "AuditEntry": {
      "identity": "entity",
      "fields": {
        "sequence_number": "int",
        "recorded_at": "datetime",
        "principal": "ActingPrincipal",
        "action": "AuditAction",
        "subject": "AuditSubject",
        "outcome": "AuditOutcome",
        "contract_version": "str",
        "release_version": "str",
        "confirmation_id": "str | None",
        "erased_before": "date | None"
      }
    },
    "AuditSubject": {
      "kind": "discriminated_union",
      "discriminator": "subject_kind",
      "variants": [
        "ProjectSubject",
        "CustomerSubject",
        "SessionProjectSubject",
        "ImportSubject",
        "NoSubject"
      ]
    },
    "ProjectSubject": {
      "identity": "value",
      "fields": {
        "subject_kind": "Literal['project']",
        "project_id": "str"
      }
    },
    "CustomerSubject": {
      "identity": "value",
      "fields": {
        "subject_kind": "Literal['customer']",
        "customer_ref": "str"
      }
    },
    "SessionProjectSubject": {
      "identity": "value",
      "fields": {
        "subject_kind": "Literal['session_project']",
        "session_id": "str",
        "project_id": "str"
      }
    },
    "ImportSubject": {
      "identity": "value",
      "fields": {
        "subject_kind": "Literal['import']",
        "file_digest": "str"
      }
    },
    "NoSubject": {
      "identity": "value",
      "fields": {
        "subject_kind": "Literal['none']"
      }
    },
    "MigrationClosure": {
      "identity": "entity",
      "fields": {
        "file_digest": "str",
        "accepted_at": "datetime",
        "principal": "ActingPrincipal",
        "confirmation_id": "str"
      }
    },
    "OwnerSession": {
      "identity": "entity",
      "fields": {
        "session_id": "str",
        "csrf_value": "str",
        "signed_in_reading": "int",
        "last_request_reading": "int",
        "signed_out": "bool",
        "pending_confirmation": "PendingConfirmation | None",
        "uploaded_file": "UploadedFile | None",
        "last_upload_number": "int"
      }
    },
    "PendingConfirmation": {
      "identity": "value",
      "fields": {
        "confirmation_value": "str",
        "action": "ConfirmedAction",
        "target": "str | None",
        "stated_version": "int | None",
        "inputs_digest": "str",
        "shown_reading": "int"
      }
    },
    "UploadedFile": {
      "identity": "value",
      "fields": {
        "content": "bytes",
        "file_digest": "str",
        "upload_number": "int"
      }
    },
    "AuditSequence": {
      "identity": "entity",
      "fields": {
        "last_sequence_number": "int"
      }
    },
    "OwnerFormField": {
      "identity": "value",
      "fields": {
        "name": "str",
        "carrier": "OwnerFormCarrier",
        "reads_as": "FormValueKind"
      }
    }
  }
}
