        "module:backups",
        "module:configuration",
        "module:instance_lifecycle",
        "module:owner_interface",
        "module:owner_sessions",
        "module:release_declarations",
        "module:service_api",
        "module:store"
      ],
      "candidate_capabilities": [
        "capability:backups.probe_backup_location",
