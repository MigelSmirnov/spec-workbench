  "raw": "{\"judgements\":[{\"id\":\"T1\",\"kind\":\"judged_before\",\"quotes\":[],\"later_state\":null,\"precedent\":\"P1\",\"divergence\":\"\",\"why\":\"This asks the same question as P1 on unchanged text: an omitted override uses the v1 display name.\",\"witness\":{\"initial\":\"\",\"events\":[],\"outcomes\":[\"\",\"\"],\"observer\":\"\",\"basis\":[]},\"bases\":[]},{\"id\":\"T2\",\"kind\":\"answered\",\"quotes\":[\"For each Customer it will make, the\\n   owner gives its name and kind and says whether the v1 value is its tax id;\\n   confirmation is refused while any of these is missing (A02).\",\"While the\\n   mapping shows a malformed record, a conflict or a missing value, the\\n   import's confirmation step is not shown; at confirmation Registry checks\\n   again (rule 6).\",\"and whether the mapping is clean — no malformed record, no conflict,\\nno missing value and at least one pick — which alone lets the confirmation\\nstep be shown.\",\"a display name, a Customer's name or kind absent or\\nblank is no refusal here but a missing value the mapping shows — named by\\nits subject, the picked project by `project_id` or the Customer by its v1\\nvalue, and by its field — which keeps it from being clean;\"],\"later_state\":null,\"precedent\":null,\"divergence\":\"\",\"why\":\"A missing owner-supplied value, including the required tax-id decision, is shown as a missing field, makes the mapping non-clean, and prevents the confirmation step from being shown; “refusal only at confirmation” distinguishes a mapping finding from an operation refusal and does not permit showing the step.\",\"witness\":{\"initial\":\"\",\"events\":[],\"outcomes\":[\"\",\"\"],\"observer\":\"\",\"basis\":[]},\"bases\":[]},{\"id\":\"T3\",\"kind\":\"judged_before\",\"quotes\":[],\"later_state\":null,\"precedent\":\"P5\",\"divergence\":\"\",\"why\":\"This is the same unchanged question as P5 about the input schema and transport decoding needed to preserve duplicate Customer mapping entries.\",\"witness\":{\"initial\":\"\",\"events\":[],\"outcomes\":[\"\",\"\"],\"observer\":\"\",\"basis\":[]},\"bases\":[]},{\"id\":\"T4\",\"kind\":\"judged_before\",\"quotes\":[],\"later_state\":null,\"precedent\":\"P2\",\"divergence\":\"\",\"why\":\"This is the same unchanged question as P2: a nonblank Customer kind outside `person` or `company` is refused as `invalid_request` with `outside_closed_list`.\",\"witness\":{\"initial\":\"\",\"events\":[],\"outcomes\":[\"\",\"\"],\"observer\":\"\",\"basis\":[]},\"bases\":[]}]}"
 },
