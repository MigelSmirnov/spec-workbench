 "topics": [
  {
   "topic": "Required rollback of persistent engine side effects when listener startup fails",
   "members": [
    "r3.00"
   ],
   "runs": [
    3
   ],
   "questions": [
    "After opening an existing store and then failing to open a listener, must Registry undo auxiliary files or other persistent engine state created or changed during that start, or may it leave them behind so long as the records are unchanged?"
   ],
   "units": [
    "A17"
   ],
   "witnessed_by": [
    "r3.00"
   ],
   "id": "T1",
   "judgement": {
    "kind": "answered",
    "quotes": [
     "A failed start leaves no file it made but one it could not remove: a probe, which the next backup run removes with the other temporary files (A18 rule 4); a file of the store's temporary name, which the next start removes first (rule 5); or a store it made new for a start a listener then failed, which it removes — one it cannot remove is an empty store of the release's version, which the next start opens as any store."
    ],
    "later_state": null,
    "divergence": "",
    "why": "A17 exhaustively limits files that a failed start may leave, so an auxiliary engine file created during that start must be removed and may not persist merely because application records are unchanged.",
    "verified": true,
    "blocking": false
   }
  }
 ],
 "open_units": []
}
