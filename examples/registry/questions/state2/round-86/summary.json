 "topics": [
  {
   "topic": "Scope and definition of the owner-interface no-public-port requirement",
   "members": [
    "r2.00"
   ],
   "runs": [
    2
   ],
   "questions": [
    "Does “with no public port” constrain the owner interface only, or the owner's VPN endpoint as well, and precisely what makes a port “public” for this rule?"
   ],
   "units": [
    "?"
   ],
   "witnessed_by": [
    "r2.00"
   ],
   "id": "T1",
   "judgement": {
    "kind": "answered",
    "quotes": [
     "The owner reaches the owner interface from outside only through the\nowner's VPN; it has no public port.",
     "The addresses are the deployment's: the\n   service API is reachable only in VM Platform and over the WireGuard\n   channel from the VPS, the owner interface from beyond the home server\n   only through the owner's VPN, with no public port (R0-28, R0-29, R0-48), and the interface each is bound to on that host,\n   or on a test instance's (R0-34), is the host's administration — so the\n   configuration names them"
    ],
    "later_state": null,
    "divergence": "",
    "why": "Both passages attach the no-public-port constraint to the owner interface, while requiring remote access through the owner's VPN; they do not prohibit a publicly reachable endpoint belonging to the VPN itself.",
