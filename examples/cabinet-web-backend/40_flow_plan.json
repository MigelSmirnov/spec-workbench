        "capability:sync_gateway.serve_sync_request",
        "capability:access_control.authenticate_request",
        "capability:access_control.authorize_capability",
        "capability:registry_replica.publish_registry_catalogue",
        "capability:registry_replica.get_current_registry_catalogue"
      ]
    },
    {
      "key": "flow:release_verified_vps_working_set",
      "purpose": "Release exact VPS working bytes only after confirmation, receipt hashes, and exact local durable-verification membership, retaining all logical and audit facts.",
      "required_modules": [
        "module:chatgpt_interaction",
        "module:access_control",
        "module:effect_journal",
        "module:source_custody",
        "module:invoice_exchange"
      ],
