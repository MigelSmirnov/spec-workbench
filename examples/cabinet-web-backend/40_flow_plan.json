        "module:capability_policy",
        "module:chatgpt_interaction",
        "module:access_control",
        "module:card_workspace",
        "module:invoice_workspace",
        "module:project_workspace",
        "module:registry_replica"
      ],
      "candidate_capabilities": [
        "capability:capability_policy.resolve_capability",
        "capability:access_control.authenticate_request",
        "capability:access_control.authorize_capability",
        "capability:card_workspace.search_provider_cards",
        "capability:card_workspace.list_project_cards",
        "capability:project_workspace.get_project_summary",
        "capability:invoice_workspace.search_invoices",
        "capability:invoice_workspace.get_invoice",
