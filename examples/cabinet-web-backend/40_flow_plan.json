        "capability:sync_gateway.serve_sync_request",
        "capability:access_control.authenticate_request",
        "capability:access_control.authorize_capability",
        "capability:invoice_exchange.discover_invoice_work",
        "capability:card_workspace.get_card_revision",
        "capability:source_custody.retrieve_original_source",
