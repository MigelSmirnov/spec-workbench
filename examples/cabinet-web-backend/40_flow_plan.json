    {
      "key": "flow:rotate_or_revoke_credential",
      "purpose": "Perform a protected operator credential lifecycle change without changing business identity or exposing reusable secret material.",
      "required_modules": [
        "module:access_control",
        "module:runtime_control"
      ],
      "candidate_capabilities": [
        "capability:runtime_control.evaluate_readiness",
        "capability:access_control.authenticate_request",
        "capability:access_control.authorize_capability",
        "capability:access_control.enroll_principal",
        "capability:access_control.provision_capability_grant",
        "capability:access_control.rotate_credential",
        "capability:access_control.revoke_credential"
