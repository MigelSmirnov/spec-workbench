        "capability:invoice_exchange.reconcile_invoice_transfer",
        "capability:effect_journal.begin_effect",
        "capability:source_custody.release_vps_working_set",
        "capability:effect_journal.commit_effect",
        "capability:chatgpt_interaction.report_composite_outcome"
