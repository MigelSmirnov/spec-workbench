{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cabinet:legacy-invoice-snapshot:v1",
  "title": "Read-only audited Cabinet_web invoice snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_commit",
    "association_audit_sha256",
    "invoice_schema_sha256",
    "unassociated_original_count",
    "invoices"
  ],
  "properties": {
    "schema_version": {
      "const": "cabinet_legacy_invoice_snapshot.v1"
    },
    "repository_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "association_audit_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "invoice_schema_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unassociated_original_count": {
      "type": "integer",
      "minimum": 0
    },
    "invoices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/invoice"
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "content_id",
        "content_sha256",
        "size_bytes",
        "media_type",
        "display_filename"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "content_id": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "enum": [
            "image/jpeg",
            "application/pdf"
          ]
        },
        "display_filename": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "source_id",
        "card_content_hash",
        "association_audit_sha256",
        "files"
      ],
      "properties": {
        "card_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "card_content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "association_audit_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "invoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "card_raw_sha256",
        "card_content_hash",
        "card",
        "source_set",
        "source_set_hash",
        "capture_raw_sha256",
        "capture_state",
        "document_completeness"
      ],
      "properties": {
        "card_id": {
          "type": "string",
          "minLength": 1
        },
        "card_raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "card_content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "card": {
          "$ref": "#/$defs/InvoiceCardV1"
        },
        "source_set": {
          "$ref": "#/$defs/source_set"
        },
        "source_set_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "capture_raw_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "capture_state": {
          "enum": [
            "missing",
            "invalid",
            "stale",
            "mismatch",
            "incomplete",
            "verified_legacy_capture"
          ]
        },
        "document_completeness": {
          "const": "not_asserted"
        }
      }
    },
    "InvoiceCardV1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://cabinet.local/schemas/invoice-card-v1.schema.json",
      "title": "Cabinet Invoice Card Version 1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_type",
        "card_version",
        "id",
        "status",
        "invoice_number",
        "issue_date",
        "service_date",
        "due_date",
        "currency",
        "supplier",
        "buyer",
        "object",
        "lines",
        "totals",
        "payment",
        "source",
        "provenance"
      ],
      "properties": {
        "card_type": {
          "const": "invoice"
        },
        "card_version": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^invoice-[a-z0-9][a-z0-9-]*$"
        },
        "status": {
          "enum": [
            "draft",
            "confirmed",
            "archived"
          ]
        },
        "invoice_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "issue_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "service_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "due_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "supplier": {
          "$ref": "#/$defs/party"
        },
        "buyer": {
          "$ref": "#/$defs/party"
        },
        "object": {
          "$ref": "#/$defs/objectAssignment"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "totals": {
          "$ref": "#/$defs/totals"
        },
        "payment": {
          "$ref": "#/$defs/payment"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "$defs": {
        "nullableText": {
          "type": [
            "string",
            "null"
          ]
        },
        "money": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
        },
        "quantity": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,4})?$"
        },
        "percent": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "party": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "tax_id",
            "address"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/nullableText"
            },
            "tax_id": {
              "$ref": "#/$defs/nullableText"
            },
            "address": {
              "$ref": "#/$defs/nullableText"
            }
          }
        },
        "objectAssignment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "card_id",
            "label"
          ],
          "properties": {
            "card_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^object-[a-z0-9][a-z0-9-]*$"
            },
            "label": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "line": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line_id",
            "kind",
            "description_original",
            "description_normalized",
            "supplier_sku",
            "matched_material_id",
            "quantity",
            "unit",
            "unit_price_net",
            "discount_percent",
            "discount_amount",
            "net_amount",
            "tax_rate",
            "tax_amount",
            "gross_amount"
          ],
          "properties": {
            "line_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "material",
                "labor",
                "equipment",
                "transport",
                "service",
                "fee",
                "other"
              ]
            },
            "description_original": {
              "type": "string",
              "minLength": 1
            },
            "description_normalized": {
              "$ref": "#/$defs/nullableText"
            },
            "supplier_sku": {
              "$ref": "#/$defs/nullableText"
            },
            "matched_material_id": {
              "$ref": "#/$defs/nullableText"
            },
            "quantity": {
              "$ref": "#/$defs/quantity"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "unit_price_net": {
              "$ref": "#/$defs/money"
            },
            "discount_percent": {
              "$ref": "#/$defs/percent"
            },
            "discount_amount": {
              "$ref": "#/$defs/money"
            },
            "net_amount": {
              "$ref": "#/$defs/money"
            },
            "tax_rate": {
              "$ref": "#/$defs/percent"
            },
            "tax_amount": {
              "$ref": "#/$defs/money"
            },
            "gross_amount": {
              "$ref": "#/$defs/money"
            }
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "net",
            "discount",
            "tax",
            "gross",
            "withholding",
            "payable"
          ],
          "properties": {
            "net": {
              "$ref": "#/$defs/money"
            },
            "discount": {
              "$ref": "#/$defs/money"
            },
            "tax": {
              "$ref": "#/$defs/money"
            },
            "gross": {
              "$ref": "#/$defs/money"
            },
            "withholding": {
              "$ref": "#/$defs/money"
            },
            "payable": {
              "$ref": "#/$defs/money"
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "basis",
            "source_ref"
          ],
          "properties": {
            "basis": {
              "enum": [
                "invoice_source",
                "user_statement",
                "external_record"
              ]
            },
            "source_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "transaction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payment_id",
            "method",
            "paid_at",
            "currency",
            "tendered_amount",
            "applied_amount",
            "change_amount",
            "reference",
            "evidence"
          ],
          "properties": {
            "payment_id": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "enum": [
                "cash",
                "card",
                "bank_transfer",
                "direct_debit",
                "cheque",
                "other",
                "unknown"
              ]
            },
            "paid_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "tendered_amount": {
              "anyOf": [
                {
                  "$ref": "#/$defs/money"
                },
                {
                  "type": "null"
                }
              ]
            },
            "applied_amount": {
              "$ref": "#/$defs/money"
            },
            "change_amount": {
              "anyOf": [
                {
                  "$ref": "#/$defs/money"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reference": {
              "$ref": "#/$defs/nullableText"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        "payment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "transactions"
          ],
          "properties": {
            "status": {
              "enum": [
                "unknown",
                "unpaid",
                "partially_paid",
                "paid",
                "refunded"
              ]
            },
            "transactions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/transaction"
              }
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_id",
            "kind",
            "file_ref",
            "file_status",
            "note"
          ],
          "properties": {
            "source_id": {
              "type": "string",
              "pattern": "^source-[a-z0-9][a-z0-9-]*$"
            },
            "kind": {
              "enum": [
                "photo",
                "pdf",
                "message",
                "scan",
                "other"
              ]
            },
            "file_ref": {
              "$ref": "#/$defs/nullableText"
            },
            "file_status": {
              "enum": [
                "stored",
                "not_stored",
                "pending",
                "missing"
              ]
            },
            "note": {
              "$ref": "#/$defs/nullableText"
            }
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created_at",
            "confirmed_at",
            "created_by"
          ],
          "properties": {
            "created_at": {
              "type": "string",
              "format": "date-time"
            },
            "confirmed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "created_by": {
              "enum": [
                "assistant",
                "user",
                "import"
              ]
            }
          }
        }
      }
    }
  }
}
