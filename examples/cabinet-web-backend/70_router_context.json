{
  "schema_version": "spec_workbench_router_context.v1",
  "status": "closed",
  "backend": {
    "framework": "fastapi",
    "emitter": "fastapi_sync_v1"
  },
  "wiring": {
    "module": "api",
    "app_factory": "create_app",
    "request_parameter": "request",
    "state_bindings": {
      "capability_policy": {
        "factory_parameter": "capability_policy",
        "state_attribute": "capability_policy"
      },
      "chatgpt_interaction": {
        "factory_parameter": "chatgpt_interaction",
        "state_attribute": "chatgpt_interaction"
      },
      "access_control": {
        "factory_parameter": "access_control",
        "state_attribute": "access_control"
      },
      "card_workspace": {
        "factory_parameter": "card_workspace",
        "state_attribute": "card_workspace"
      },
      "invoice_workspace": {
        "factory_parameter": "invoice_workspace",
        "state_attribute": "invoice_workspace"
      },
      "project_workspace": {
        "factory_parameter": "project_workspace",
        "state_attribute": "project_workspace"
      },
      "effect_journal": {
        "factory_parameter": "effect_journal",
        "state_attribute": "effect_journal"
      },
      "source_custody": {
        "factory_parameter": "source_custody",
        "state_attribute": "source_custody"
      },
      "web_gateway": {
        "factory_parameter": "web_gateway",
        "state_attribute": "web_gateway"
      },
      "sync_gateway": {
        "factory_parameter": "sync_gateway",
        "state_attribute": "sync_gateway"
      },
      "invoice_exchange": {
        "factory_parameter": "invoice_exchange",
        "state_attribute": "invoice_exchange"
      },
      "registry_replica": {
        "factory_parameter": "registry_replica",
        "state_attribute": "registry_replica"
      },
      "runtime_control": {
        "factory_parameter": "runtime_control",
        "state_attribute": "runtime_control"
      }
    },
    "credential_extractors": {
      "plugin_credential": {
        "kind": "header_scheme",
        "function": "extract_plugin_credential",
        "header": "Authorization",
        "scheme": "Bearer",
        "reject_with": "AuthenticationRequiredError"
      },
      "browser_principal": {
        "kind": "header_scheme",
        "function": "extract_browser_principal",
        "header": "X-Cabinet-Authenticated-Owner",
        "scheme": "TrustedEdge",
        "reject_with": "AuthenticationRequiredError"
      },
      "local_node_credential": {
        "kind": "header_scheme",
        "function": "extract_local_node_credential",
        "header": "Authorization",
        "scheme": "Bearer",
        "reject_with": "AuthenticationRequiredError"
      }
    }
  },
  "principals": {
    "plugin_owner": {
      "resolver": "resolve_plugin_principal",
      "args": [
        {
          "ref": "slot",
          "name": "access_control"
        },
        {
          "ref": "credential",
          "name": "plugin_credential"
        }
      ]
    },
    "browser_owner": {
      "resolver": "resolve_browser_principal",
      "args": [
        {
          "ref": "slot",
          "name": "access_control"
        },
        {
          "ref": "credential",
          "name": "browser_principal"
        }
      ]
    },
    "local_node": {
      "resolver": "resolve_local_node_principal",
      "args": [
        {
          "ref": "slot",
          "name": "access_control"
        },
        {
          "ref": "credential",
          "name": "local_node_credential"
        }
      ]
    }
  },
  "auth_policies": {
    "plugin_bearer": {
      "principal": "plugin_owner"
    },
    "browser_edge": {
      "principal": "browser_owner"
    },
    "local_bearer": {
      "principal": "local_node"
    }
  },
  "projections": [],
  "error_policy": {
    "body": "empty",
    "default_status": 500,
    "mapping": [
      {
        "exception": "AuthenticationRequiredError",
        "status": 401
      },
      {
        "exception": "AuthorizationDeniedError",
        "status": 403
      },
      {
        "exception": "ResourceNotFoundError",
        "status": 404
      },
      {
        "exception": "RevisionConflictError",
        "status": 409
      },
      {
        "exception": "IdempotencyConflictError",
        "status": 409
      },
      {
        "exception": "ConfirmationRequiredError",
        "status": 409
      },
      {
        "exception": "OutcomeUnknownError",
        "status": 409
      },
      {
        "exception": "RequestTooLargeError",
        "status": 413
      },
      {
        "exception": "UnsupportedMediaTypeError",
        "status": 415
      },
      {
        "exception": "ValidationRejectedError",
        "status": 422
      },
      {
        "exception": "IntegrityMismatchError",
        "status": 422
      },
      {
        "exception": "ContractIncompatibleError",
        "status": 426
      },
      {
        "exception": "AuthenticationThrottledError",
        "status": 429
      },
      {
        "exception": "ServiceUnavailableError",
        "status": 503
      },
      {
        "exception": "BackupVerificationFailedError",
        "status": 503
      }
    ],
    "unavailable_to_module": []
  },
  "unresolved": []
}
