        "value_type": "record_tuple",
        "row_model": "InvoiceValidationCheckRule",
        "value": [
          {
            "code": "invoice.card_type",
            "field_path": "card_type",
            "formula": "equals_constant(INVOICE_CARD_TYPE)"
          },
          {
            "code": "invoice.card_version",
            "field_path": "card_version",
            "formula": "equals_constant(INVOICE_CARD_VERSION)"
          },
          {
            "code": "invoice.id",
            "field_path": "id",
            "formula": "non_empty()"
          },
          {
            "code": "invoice.lifecycle",
            "field_path": "status",
            "formula": "one_of_enum(InvoiceLifecycleState)"
          },
          {
            "code": "invoice.currency",
            "field_path": "currency",
            "formula": "non_empty()"
          },
          {
            "code": "invoice.source_identity",
            "field_path": "source.source_id",
            "formula": "non_empty()"
          },
          {
            "code": "invoice.source_kind",
            "field_path": "source.kind",
            "formula": "one_of_enum(InvoiceSourceKind)"
          },
          {
            "code": "invoice.source_file_status",
            "field_path": "source.file_status",
            "formula": "one_of_enum(InvoiceSourceFileStatus)"
          },
          {
            "code": "invoice.line_id",
            "field_path": "lines.*.line_id",
            "formula": "non_empty()"
          },
          {
            "code": "invoice.line_kind",
            "field_path": "lines.*.kind",
            "formula": "one_of_enum(InvoiceLineKind)"
          },
          {
            "code": "invoice.line_net",
            "field_path": "lines.*.net_amount",
            "formula": "round_half_up(quantity * unit_price_net - discount_amount)"
          },
          {
            "code": "invoice.line_gross",
            "field_path": "lines.*.gross_amount",
            "formula": "equals_expr(net_amount + tax_amount)"
          },
          {
            "code": "invoice.total_payable",
            "field_path": "totals.payable",
            "formula": "equals_expr(gross - withholding)"
          },
          {
            "code": "invoice.payment_status",
            "field_path": "payment.status",
            "formula": "one_of_enum(InvoicePaymentStatus)"
          },
          {
            "code": "invoice.provenance_creator",
            "field_path": "provenance.created_by",
            "formula": "one_of_enum(ProvenanceCreator)"
          }
        ]
      },
