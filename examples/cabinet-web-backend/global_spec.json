    "source_byte_store_backend": {
      "kind": "source_byte_store_backend",
      "schema_version": 1,
      "backend": {
        "emitter": "python_filesystem_source_byte_store_v1"
      },
      "wiring": {
        "module": "source_byte_store",
        "concrete_class": "LocalFilesystemSourceByteStore",
        "interface": "SourceByteStore",
        "models_module": "cabinet_web_backend.models"
      },
      "layout": {
        "staging_directory": "staging",
        "final_directory": "final",
        "hash_algorithm": "sha256",
        "final_path_scheme": "sha256_content_addressed",
        "publication_primitive": "same_filesystem_atomic_rename"
      }
    },
    "invoice_workspace": {
      "card_type": "invoice",
      "card_version": 1,
      "lifecycle": {
        "draft": "draft",
        "confirmed": "confirmed",
        "archived": "archived"
      },
      "source_provenance_key": "source_provenance",
      "stored_custody_status": "stored",
      "synchronization_unavailable_status": "not_available",
      "manifest_version": "invoice-transfer-manifest-v1",
      "manifest_hash_algorithm": "sha256_canonical_json_v1",
      "manifest_hash_fields": [
        "invoice_id",
        "manifest_version",
        "generated_at",
        "card_revisions",
        "source_references"
      ],
      "manifest_id_prefix": "manifest:",
      "working_set_id_prefix": "working-set:",
      "working_set_status": "available",
      "rejection_codes": {
        "access_denied": "invoice.authorization_denied",
        "revision": "invoice.revision_conflict",
        "validation": "invoice.validation_rejected",
        "source_custody": "invoice.source_not_stored",
        "confirmation": "invoice.confirmation_invalid",
        "not_found": "invoice.not_found"
      },
      "validation_checks": [
        {
          "code": "invoice.card_type",
          "field_path": "card_type",
          "formula": "equals rules.invoice_workspace.card_type"
        },
        {
          "code": "invoice.card_version",
          "field_path": "card_version",
          "formula": "equals rules.invoice_workspace.card_version"
        },
        {
          "code": "invoice.id",
          "field_path": "id",
          "formula": "non_empty"
        },
        {
          "code": "invoice.lifecycle",
          "field_path": "status",
          "formula": "one_of rules.invoice_workspace.lifecycle values"
        },
        {
          "code": "invoice.currency",
          "field_path": "currency",
          "formula": "non_empty"
        },
        {
          "code": "invoice.source_identity",
          "field_path": "source.card_id",
          "formula": "equals invoice.id"
        },
        {
          "code": "invoice.line_net",
          "field_path": "lines.*.net_amount",
          "formula": "quantity * unit_price_net - discount_amount"
        },
        {
          "code": "invoice.line_tax",
          "field_path": "lines.*.tax_amount",
          "formula": "net_amount * tax_rate"
        },
        {
          "code": "invoice.line_gross",
          "field_path": "lines.*.gross_amount",
          "formula": "net_amount + tax_amount"
        },
        {
          "code": "invoice.total_net",
          "field_path": "totals.net_total",
          "formula": "sum lines.*.net_amount"
        },
        {
          "code": "invoice.total_tax",
          "field_path": "totals.tax_total",
          "formula": "sum lines.*.tax_amount"
        },
        {
          "code": "invoice.total_gross",
          "field_path": "totals.gross_total",
          "formula": "sum lines.*.gross_amount"
        },
        {
          "code": "invoice.payment_balance",
          "field_path": "payment",
          "formula": "paid_total + outstanding_total equals totals.gross_total"
        }
      ],
      "validation_issue_severity": "error",
      "validation_issue_message": "Invoice field violates its declared rule",
      "validation_issue_order": [
        "invoice.card_type",
        "invoice.card_version",
        "invoice.id",
        "invoice.lifecycle",
        "invoice.currency",
        "invoice.source_identity",
        "invoice.line_net",
        "invoice.line_tax",
        "invoice.line_gross",
        "invoice.total_net",
        "invoice.total_tax",
        "invoice.total_gross",
        "invoice.payment_balance"
      ]
    }
  }
}
