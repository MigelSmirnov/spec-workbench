{
  "schema_version": "spec_workbench_router_context.v1",
  "status": "closed",
  "backend": {
    "framework": "fastapi",
    "emitter": "fastapi_sync_v1"
  },
  "wiring": {
    "module": "http_router",
    "app_factory": "create_http_app",
    "request_parameter": "request",
    "state_bindings": {
      "gateway_runtime": {
        "factory_parameter": "runtime",
        "state_attribute": "gateway_runtime"
      }
    },
    "credential_extractors": {
      "bearer": {
        "kind": "header_scheme",
        "function": "extract_http_bearer",
        "header": "Authorization",
        "scheme": "Bearer",
        "reject_with": "HttpCredentialError"
      }
    }
  },
  "principals": {},
  "auth_policies": {
    "kernel_actor": {
      "principal": null
    },
    "kernel_owner": {
      "principal": null
    }
  },
  "projections": [],
  "error_policy": {
    "body": "empty",
    "default_status": 500,
    "mapping": [
      {
        "exception": "HttpCredentialError",
        "status": 401
      },
      {
        "exception": "HttpFramingError",
        "status": 400
      }
    ],
    "unavailable_to_module": []
  },
  "unresolved": []
}
