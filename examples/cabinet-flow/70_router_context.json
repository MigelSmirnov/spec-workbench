{
  "schema_version": "spec_workbench_router_context.v1",
  "status": "closed",
  "backend": {
    "framework": "fastapi",
    "emitter": "fastapi_sync_v1"
  },
  "wiring": {
    "module": "http_gateway",
    "app_factory": "create_app",
    "request_parameter": "request",
    "state_bindings": {
      "kernel_surface": {
        "factory_parameter": "kernel_surface",
        "state_attribute": "kernel_surface"
      },
      "access_control": {
        "factory_parameter": "access_control",
        "state_attribute": "access_control"
      }
    },
    "credential_extractors": {
      "http_credential": {
        "kind": "header_scheme",
        "function": "extract_http_credential",
        "header": "Authorization",
        "scheme": "Bearer",
        "reject_with": "AuthenticationRequiredError"
      }
    }
  },
  "principals": {
    "http_actor": {
      "resolver": "resolve_actor",
      "args": [
        {"ref": "literal", "value": "http_api"},
        {"ref": "credential", "name": "http_credential"}
      ]
    }
  },
  "auth_policies": {
    "http_bearer": {
      "principal": "http_actor"
    }
  },
  "projections": [],
  "error_policy": {
    "body": "empty",
    "default_status": 500,
    "mapping": [
      {"exception": "AuthenticationRequiredError", "status": 401}
    ],
    "unavailable_to_module": []
  },
  "unresolved": []
}
