{
  "project_root": "cabinet-flow",
  "ready": true,
  "rules": {
    "http_router_backend": {
      "auth_policies": {
        "kernel_actor": {
          "principal": null
        },
        "kernel_owner": {
          "principal": null
        }
      },
      "backend": {
        "emitter": "fastapi_sync_v1",
        "framework": "fastapi"
      },
      "error_policy": {
        "body": "empty",
        "default_status": 500,
        "mapping": [
          {
            "exception": "HttpCredentialError",
            "status": 401
          },
          {
            "exception": "HttpFramingError",
            "status": 400
          }
        ],
        "unavailable_to_module": []
      },
      "irregular_ownership": {
        "module": "http_gateway"
      },
      "kind": "http_router_backend",
      "principals": {},
      "projections": [],
      "routes": [
        {
          "auth": "kernel_actor",
          "emission": "irregular",
          "handler": "activate_handler",
          "irregular_reason": "The bounded asynchronous request stream must create an opaque credential context and preserve typed refusal envelopes; v1 table lowering cannot perform this framing.",
          "method": "POST",
          "path": "/v1/kernel/activate",
          "response_mode": "json",
          "success_status": 200
        },
        {
          "auth": "kernel_actor",
          "emission": "irregular",
          "handler": "author_handler",
          "irregular_reason": "The bounded asynchronous request stream must create an opaque credential context and preserve typed refusal envelopes; v1 table lowering cannot perform this framing.",
          "method": "POST",
          "path": "/v1/kernel/author",
          "response_mode": "json",
          "success_status": 200
        },
        {
          "auth": "kernel_actor",
          "emission": "irregular",
          "handler": "inspect_handler",
          "irregular_reason": "The bounded asynchronous request stream must create an opaque credential context and preserve typed refusal envelopes; v1 table lowering cannot perform this framing.",
          "method": "POST",
          "path": "/v1/kernel/inspect",
          "response_mode": "json",
          "success_status": 200
        },
        {
          "auth": "kernel_owner",
          "emission": "irregular",
          "handler": "owner_decide_handler",
          "irregular_reason": "The bounded asynchronous request stream must create an opaque credential context and preserve typed refusal envelopes; v1 table lowering cannot perform this framing.",
          "method": "POST",
          "path": "/v1/kernel/owner_decide",
          "response_mode": "json",
          "success_status": 200
        },
        {
          "auth": "kernel_actor",
          "emission": "irregular",
          "handler": "request_trial_handler",
          "irregular_reason": "The bounded asynchronous request stream must create an opaque credential context and preserve typed refusal envelopes; v1 table lowering cannot perform this framing.",
          "method": "POST",
          "path": "/v1/kernel/request_trial",
          "response_mode": "json",
          "success_status": 200
        },
        {
          "auth": "kernel_actor",
          "emission": "irregular",
          "handler": "run_flow_handler",
          "irregular_reason": "The bounded asynchronous request stream must create an opaque credential context and preserve typed refusal envelopes; v1 table lowering cannot perform this framing.",
          "method": "POST",
          "path": "/v1/kernel/run_flow",
          "response_mode": "json",
          "success_status": 200
        }
      ],
      "schema_version": 1,
      "wiring": {
        "app_factory": "create_http_app",
        "credential_extractors": {
          "bearer": {
            "function": "extract_http_bearer",
            "header": "Authorization",
            "kind": "header_scheme",
            "reject_with": "HttpCredentialError",
            "scheme": "Bearer"
          }
        },
        "module": "http_router",
        "request_parameter": "request",
        "state_bindings": {
          "gateway_runtime": {
            "factory_parameter": "runtime",
            "state_attribute": "gateway_runtime"
          }
        }
      }
    }
  },
  "schema_version": "spec_workbench_http_router_backend_handoff.v1",
  "source_artifacts": [
    "70_router_context.json",
    "70_router_closure.json",
    "60_contracts.json"
  ]
}
