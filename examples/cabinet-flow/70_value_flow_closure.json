{
  "schema_version": "spec_workbench_value_flow_closure.v1",
  "status": "closed",
  "outputs": {
    "flow_version": {
      "FlowVersion.authored_at": {
        "source": "stored"
      }
    },
    "cancel_run": {
      "FlowRun.created_at": {
        "source": "stored"
      }
    },
    "request_trial": {
      "AdmissionVerdict.decided_at": {
        "source": "callee",
        "via": "run_trial"
      }
    }
  },
  "inputs": {
    "activate_flow_version": {
      "flow_id": {
        "sink": "key",
        "to": "Flow.flow_id"
      },
      "expected_current_activation_ref": {
        "sink": "guard"
      }
    },
    "activate_implementation": {
      "expected_current_activation_ref": {
        "sink": "guard"
      }
    },
    "capture_trial_case": {
      "slot_id": {
        "sink": "key",
        "to": "Slot.slot_id"
      },
      "node_execution_ref": {
        "sink": "field",
        "to": "TrialCase.origin_node_execution_ref"
      },
      "input_port_ids": {
        "sink": "key",
        "to": "SemanticPort.port_id"
      }
    },
    "create_run": {
      "flow_ref": {
        "sink": "key",
        "to": "Flow.flow_id"
      }
    },
    "grant_standing_approval": {
      "expected_current_grant_ref": {
        "sink": "guard"
      }
    },
    "issue_delegation": {
      "expected_owner_principal_id": {
        "sink": "guard"
      }
    },
    "retire_flow": {
      "expected_status": {
        "sink": "guard"
      },
      "expected_current_activation_ref": {
        "sink": "guard"
      },
      "reason": {
        "sink": "field",
        "to": "Flow.retirement_reason"
      }
    },
    "retire_slot": {
      "expected_status": {
        "sink": "guard"
      },
      "reason": {
        "sink": "field",
        "to": "Slot.retirement_reason"
      }
    },
    "revoke_delegation": {
      "expected_status": {
        "sink": "guard"
      },
      "reason": {
        "sink": "field",
        "to": "AgentDelegation.revocation_reason"
      }
    },
    "revoke_standing_approval": {
      "expected_status": {
        "sink": "guard"
      },
      "reason": {
        "sink": "field",
        "to": "StandingGrant.revocation_reason"
      }
    },
    "rollback_activation": {
      "earlier_implementation_ref": {
        "sink": "field",
        "to": "SlotActivation.implementation_ref"
      },
      "expected_current_activation_ref": {
        "sink": "guard"
      }
    },
    "run_trial": {
      "contract_version_ref": {
        "sink": "key",
        "to": "SlotContractVersion.contract_version_id"
      }
    },
    "submit_implementation": {
      "code_bytes": {
        "sink": "derived",
        "to": "Implementation.code_ref"
      }
    },
    "submit_proposal": {
      "content": {
        "sink": "derived",
        "to": "VocabularyProposal.proposed_content"
      }
    },
    "withdraw_trial_case": {
      "trial_case_ref": {
        "sink": "key",
        "to": "TrialCase.trial_case_id"
      },
      "expected_status": {
        "sink": "guard"
      },
      "reason": {
        "sink": "field",
        "to": "TrialCase.withdrawal_reason"
      }
    }
  }
}
