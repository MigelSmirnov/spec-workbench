+def zeroed_stat(result):
+    return os.stat_result(tuple(result)[:7] + (0, 0, 0), {
+        "st_atime": 0.0, "st_mtime": 0.0, "st_ctime": 0.0,
+        "st_atime_ns": 0, "st_mtime_ns": 0, "st_ctime_ns": 0,
+        "st_blksize": result.st_blksize, "st_blocks": result.st_blocks, "st_rdev": result.st_rdev,
+    })
+
+
+class ZeroedEntry:
+    def __init__(self, entry):
+        self._entry = entry
+
+    def __getattr__(self, name):
+        return getattr(self._entry, name)
+
+    def __fspath__(self):
+        return self._entry.__fspath__()
+
+    def stat(self, **keywords):
+        result = self._entry.stat(**keywords)
+        return zeroed_stat(result)
+
+
+class ZeroedIterator:
+    def __init__(self, iterator):
+        self._iterator = iterator
+
+    def __iter__(self):
+        return self
+
+    def __next__(self):
+        return ZeroedEntry(next(self._iterator))
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *details):
+        self._iterator.close()
+
+    def close(self):
+        self._iterator.close()
+
+
+def zero_stat_function(original):
