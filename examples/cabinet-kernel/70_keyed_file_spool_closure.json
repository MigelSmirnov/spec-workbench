{
  "schema_version": "spec_workbench_keyed_file_spool_backend_closure.v1",
  "status": "closed",
  "backend_ir": {
    "kind": "keyed_file_spool_backend",
    "schema_version": 1,
    "backend": {
      "emitter": "python_keyed_file_spool_v1"
    },
    "wiring": {
      "module": "store_spool",
      "models_module": "cabinet_kernel.models",
      "data_provider_module": "cabinet_kernel.data_provider"
    },
    "area": {
      "directory_constant": "STORE_SPOOL_AREA_DIRECTORY"
    },
    "group": {
      "alphabet": "lowercase_hex",
      "length": 32
    },
    "key": {
      "model": "SpooledFileKey",
      "fields": {
        "group": "run_id",
        "producer": "producer_node_id",
        "producer_index": "map_index",
        "attempt": "attempt_number",
        "port": "producer_port",
        "port_index": "list_index"
      }
    },
    "attempt": {
      "model": "AttemptKey",
      "fields": {
        "group": "run_id",
        "producer": "node_id",
        "producer_index": "map_index",
        "attempt": "attempt_number"
      }
    },
    "ceilings": {
      "entry_bytes_max": "RELEASE_CEILING_SPOOL_FILE_BYTES_MAX",
      "group_bytes_max": "RELEASE_CEILING_SPOOL_RUN_BYTES_MAX"
    },
    "errors": {
      "module": "store_spool",
      "refused": "SpoolRefusedError",
      "internal": "SpoolInternalError"
    },
    "layout": {
      "hash_algorithm": "sha256",
      "entry_name_scheme": "hex_sha256_text_dot_decimal_or_underscore_v1",
      "temporary_prefix": ".",
      "publication_primitive": "same_directory_atomic_rename",
      "directory_mode": "0700",
      "file_mode": "0600",
      "symlink_policy": "refuse"
    }
  }
}
