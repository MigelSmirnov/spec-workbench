{
  "schema_version": "spec_workbench_model_closure.v1",
  "status": "closed",
  "models": {
    "DisclosureClass": {
      "kind": "enum",
      "values": [
        "open",
        "business_confidential",
        "personal_data"
      ]
    },
    "EffectClass": {
      "kind": "enum",
      "values": [
        "read",
        "draft-write",
        "state-transition",
        "external-effect",
        "destructive"
      ]
    },
    "PortDirection": {
      "kind": "enum",
      "values": [
        "input",
        "output"
      ]
    },
    "Carriage": {
      "kind": "enum",
      "values": [
        "value",
        "file"
      ]
    },
    "Cardinality": {
      "kind": "enum",
      "values": [
        "one",
        "many"
      ]
    },
    "NodeKind": {
      "kind": "enum",
      "values": [
        "function",
        "operation"
      ]
    },
    "TrialCaseOrigin": {
      "kind": "enum",
      "values": [
        "authored",
        "captured"
      ]
    },
    "TrialOutcome": {
      "kind": "enum",
      "values": [
        "passed",
        "output_mismatch",
        "contract_violation",
        "sandbox_violation",
        "timeout",
        "resource_exhausted",
        "crashed"
      ]
    },
    "AdmissionVerdictKind": {
      "kind": "enum",
      "values": [
        "admitted",
        "refused"
      ]
    },
    "BindingStatus": {
      "kind": "enum",
      "values": [
        "proposed",
        "accepted"
      ]
    },
    "HttpMethod": {
      "kind": "enum",
      "values": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "ProofPhase": {
      "kind": "enum",
      "values": [
        "nodes",
        "constants",
        "edges",
        "guards",
        "cardinality",
        "fan_in",
        "cycles",
        "disclosure",
        "reach"
      ]
    },
    "RunStatus": {
      "kind": "enum",
      "values": [
        "running",
        "awaiting_approval",
        "pending",
        "succeeded",
        "failed",
        "refused",
        "cancelled"
      ]
    },
    "WaitReason": {
      "kind": "enum",
      "values": [
        "owner_approval",
        "service_unreachable",
        "outcome_unknown"
      ]
    },
    "NodeExecutionStatus": {
      "kind": "enum",
      "values": [
        "succeeded",
        "contract_violation",
        "sandbox_violation",
        "timeout",
        "resource_exhausted",
        "crashed",
        "refused_by_owner",
        "operation_refused",
        "operation_failed",
        "service_unreachable",
        "outcome_unknown",
        "skipped_by_guard",
        "upstream_failed"
      ]
    },
    "DetailCode": {
      "kind": "enum",
      "values": [
        "binding_stale",
        "instance_not_selected",
        "instance_address_missing",
        "required_header_repeated",
        "required_header_invalid",
        "plain_http_not_allowed",
        "credential_unresolved",
        "input_not_placeable",
        "redirect_not_followed",
        "value_too_large",
        "cleanup_failed",
        "applied_outputs_unknown"
      ]
    },
    "ApprovalStatus": {
      "kind": "enum",
      "values": [
        "requested",
        "approved",
        "refused",
        "used"
      ]
    },
    "GrantStatus": {
      "kind": "enum",
      "values": [
        "active",
        "revoked"
      ]
    },
    "AttemptStatus": {
      "kind": "enum",
      "values": [
        "in_flight",
        "applied",
        "not_applied",
        "not_sent",
        "unknown"
      ]
    },
    "ActorKind": {
      "kind": "enum",
      "values": [
        "owner",
        "agent",
        "kernel"
      ]
    },
    "OutputReason": {
      "kind": "enum",
      "values": [
        "skipped_by_guard",
        "not_produced"
      ]
    },
    "Actor": {
      "identity": "value",
      "fields": {
        "kind": "ActorKind",
        "agent_name": "str | None"
      }
    },
    "Port": {
      "identity": "value",
      "fields": {
        "name": "str",
        "direction": "PortDirection",
        "value_schema": "str",
        "carriage": "Carriage",
        "media_type": "str | None",
        "cardinality": "Cardinality",
        "disclosure_class": "DisclosureClass | None"
      }
    },
    "ResourceBounds": {
      "identity": "value",
      "fields": {
        "wall_time_ms": "int",
        "memory_bytes": "int",
        "output_bytes": "int",
        "process_count": "int"
      }
    },
    "PortRef": {
      "kind": "discriminated_union",
      "discriminator": "ref_kind",
      "variants": [
        "StoredValuesRef",
        "SpooledFilesRef",
        "FileFactsRef"
      ]
    },
    "Executed": {
      "kind": "discriminated_union",
      "discriminator": "executed_kind",
      "variants": [
        "ExecutedImplementation",
        "ExecutedBinding"
      ]
    },
    "AdmissionRefusalReason": {
      "kind": "discriminated_union",
      "discriminator": "reason_kind",
      "variants": [
        "EmptyCorpusRefusal",
        "FailingCaseRefusal"
      ]
    },
    "Authority": {
      "kind": "discriminated_union",
      "discriminator": "authority_kind",
      "variants": [
        "ApprovalAuthority",
        "GrantAuthority",
        "ActivationAuthority"
      ]
    },
    "RequestBodyDescription": {
      "kind": "discriminated_union",
      "discriminator": "body_kind",
      "variants": [
        "JsonBodyDescription",
        "MultipartBodyDescription"
      ]
    },
    "Slot": {
      "identity": "entity",
      "fields": {
        "slot_id": "str",
        "purpose": "str",
        "created_by": "Actor",
        "created_at": "KernelInstant"
      }
    },
    "ContractVersion": {
      "identity": "value",
      "fields": {
        "contract_version_id": "str",
        "slot_id": "str",
        "inputs": "tuple[Port, ...]",
        "outputs": "tuple[Port, ...]",
        "resource_bounds": "ResourceBounds",
        "issued_by": "Actor",
        "issued_at": "KernelInstant"
      }
    },
    "Implementation": {
      "identity": "value",
      "fields": {
        "implementation_id": "str",
        "contract_version_id": "str",
        "code": "str",
        "submitted_by": "Actor",
        "submitted_at": "KernelInstant"
      }
    },
    "TrialCase": {
      "identity": "value",
      "fields": {
        "trial_case_id": "str",
        "contract_version_id": "str",
        "inputs": "tuple[PortRef, ...]",
        "expected_outputs": "tuple[PortRef, ...] | None",
        "origin": "TrialCaseOrigin",
        "captured_from": "AttemptKey | None",
        "added_by": "Actor",
        "added_at": "KernelInstant"
      }
    },
    "TrialExecution": {
      "identity": "entity",
      "fields": {
        "trial_execution_id": "str",
        "implementation_id": "str",
        "trial_case_id": "str",
        "outcome": "TrialOutcome",
        "outputs": "tuple[PortRef, ...] | None",
        "resources_used": "ResourceUsage",
        "detail_code": "DetailCode | None",
        "failure_detail": "str | None",
        "executed_at": "KernelInstant",
        "executed_by": "Actor"
      }
    },
    "AdmissionVerdict": {
      "identity": "value",
      "fields": {
        "implementation_id": "str",
        "corpus_digest": "str",
        "trial_executions": "tuple[str, ...]",
        "verdict": "AdmissionVerdictKind",
        "reason": "AdmissionRefusalReason | None",
        "decided_at": "KernelInstant"
      }
    },
    "Activation": {
      "identity": "entity",
      "fields": {
        "store_position": "int",
        "contract_version_id": "str",
        "implementation_id": "str",
        "activated_by": "Actor",
        "activated_at": "KernelInstant"
      }
    },
    "ManifestOperation": {
      "identity": "value",
      "fields": {
        "service_id": "str",
        "operation_name": "str",
        "record_digest": "str",
        "effect_class": "EffectClass",
        "idempotency_key_fields": "tuple[str, ...]",
        "http_method": "HttpMethod",
        "path": "str",
        "base_url": "str | None",
        "required_headers": "tuple[HeaderField, ...] | None",
        "instance_class": "str | None"
      }
    },
    "OperationBinding": {
      "identity": "entity",
      "fields": {
        "binding_id": "str",
        "service_id": "str",
        "operation_name": "str",
        "record_digest": "str",
        "effect_class": "EffectClass",
        "idempotency_key_fields": "tuple[str, ...]",
        "inputs": "tuple[Port, ...]",
        "outputs": "tuple[Port, ...]",
        "status": "BindingStatus",
        "proposed_by": "Actor",
        "proposed_at": "KernelInstant",
        "accepted_by": "Actor | None",
        "accepted_at": "KernelInstant | None"
      }
    },
    "Flow": {
      "identity": "entity",
      "fields": {
        "flow_id": "str",
        "purpose": "str",
        "created_by": "Actor",
        "created_at": "KernelInstant"
      }
    },
    "FlowNode": {
      "identity": "value",
      "fields": {
        "node_id": "str",
        "kind": "NodeKind",
        "contract_version_id": "str | None",
        "binding_id": "str | None",
        "map_over": "str | None"
      }
    },
    "FlowEdge": {
      "identity": "value",
      "fields": {
        "from_node": "str",
        "from_port": "str",
        "to_node": "str",
        "to_port": "str",
        "guard": "EdgeGuard | None"
      }
    },
    "FlowConstant": {
      "identity": "value",
      "fields": {
        "to_node": "str",
        "to_port": "str",
        "value": "str"
      }
    },
    "FlowVersion": {
      "identity": "value",
      "fields": {
        "flow_version_id": "str",
        "flow_id": "str",
        "inputs": "tuple[Port, ...]",
        "outputs": "tuple[Port, ...]",
        "nodes": "tuple[FlowNode, ...]",
        "edges": "tuple[FlowEdge, ...]",
        "constants": "tuple[FlowConstant, ...]",
        "authored_by": "Actor",
        "authored_at": "KernelInstant"
      }
    },
    "ProofResult": {
      "identity": "value",
      "fields": {
        "flow_version_id": "str",
        "proven": "bool",
        "failure": "ProofFailure | None",
        "highest_effect_class": "EffectClass | None"
      }
    },
    "FlowActivation": {
      "identity": "entity",
      "fields": {
        "store_position": "int",
        "flow_version_id": "str",
        "highest_effect_class": "EffectClass",
        "activated_by": "Actor",
        "activated_at": "KernelInstant"
      }
    },
    "WaitingPoint": {
      "identity": "value",
      "fields": {
        "node_id": "str",
        "map_index": "int | None",
        "reason": "WaitReason"
      }
    },
    "Run": {
      "identity": "entity",
      "fields": {
        "run_id": "str",
        "flow_version_id": "str",
        "pinned_implementations": "tuple[PinnedImplementation, ...]",
        "inputs": "tuple[PortRef, ...]",
        "outputs": "tuple[PortRef, ...]",
        "status": "RunStatus",
        "cancelled_by": "Actor | None",
        "waiting": "tuple[WaitingPoint, ...]",
        "started_by": "Actor",
        "started_at": "KernelInstant",
        "ended_at": "KernelInstant | None",
        "resumptions": "tuple[Resumption, ...]",
        "released_by": "Actor | None",
        "released_at": "KernelInstant | None"
      }
    },
    "StoredValue": {
      "identity": "value",
      "fields": {
        "value_id": "str",
        "value_digest": "str",
        "carriage": "Carriage",
        "media_type": "str | None",
        "value_schema": "str",
        "disclosure_class": "DisclosureClass",
        "size_bytes": "int"
      }
    },
    "SpooledFile": {
      "identity": "value",
      "fields": {
        "run_id": "str",
        "producer_node_id": "str",
        "map_index": "int | None",
        "attempt_number": "int",
        "producer_port": "str",
        "list_index": "int | None",
        "content_digest": "str",
        "size_bytes": "int",
        "media_type": "str",
        "disclosure_class": "DisclosureClass"
      }
    },
    "NodeExecution": {
      "identity": "value",
      "fields": {
        "run_id": "str",
        "node_id": "str",
        "map_index": "int | None",
        "attempt_number": "int",
        "executed": "Executed | None",
        "inputs": "tuple[PortRef, ...]",
        "outputs": "tuple[PortRef, ...]",
        "status": "NodeExecutionStatus",
        "detail_code": "DetailCode | None",
        "failure_detail": "str | None",
        "resources_used": "ResourceUsage | None",
        "started_at": "KernelInstant",
        "ended_at": "KernelInstant"
      }
    },
    "EffectApproval": {
      "identity": "entity",
      "fields": {
        "approval_id": "str",
        "run_id": "str",
        "node_id": "str",
        "map_index": "int | None",
        "binding_id": "str",
        "attempt_number": "int",
        "input_digests": "tuple[str, ...]",
        "request_digest": "str",
        "preview": "ApprovalPreview",
        "status": "ApprovalStatus",
        "requested_at": "KernelInstant",
        "decided_by": "Actor | None",
        "decided_at": "KernelInstant | None"
      }
    },
    "StandingGrant": {
      "identity": "entity",
      "fields": {
        "grant_id": "str",
        "flow_version_id": "str",
        "node_id": "str",
        "status": "GrantStatus",
        "granted_by": "Actor",
        "granted_at": "KernelInstant",
        "revoked_by": "Actor | None",
        "revoked_at": "KernelInstant | None"
      }
    },
    "EffectAttempt": {
      "identity": "entity",
      "fields": {
        "run_id": "str",
        "node_id": "str",
        "map_index": "int | None",
        "attempt_number": "int",
        "binding_id": "str",
        "inputs": "tuple[PortRef, ...]",
        "idempotency_key": "str | None",
        "authority": "Authority",
        "status": "AttemptStatus",
        "recorded_at": "KernelInstant",
        "concluded_at": "KernelInstant | None",
        "resolved_by": "Actor | None"
      }
    },
    "Installation": {
      "identity": "value",
      "fields": {
        "data_directory": "str",
        "manifest_location": "str",
        "manifest_revision": "str",
        "service_instances": "tuple[ServiceInstanceSelection, ...]",
        "service_credentials": "tuple[ServiceCredential, ...]",
        "owner_token": "str",
        "agent_tokens": "tuple[AgentToken, ...]",
        "mcp_listen_address": "str"
      }
    }
  }
}
