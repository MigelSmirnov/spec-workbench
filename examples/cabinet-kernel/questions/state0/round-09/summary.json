 "topics": [
  {
   "topic": "Whether and how verbatim-secret detection applies to opaque service-returned file contents",
   "members": [
    "r2.00",
    "r3.00"
   ],
   "runs": [
    2,
    3
   ],
   "questions": [
    "Does verbatim-secret detection apply to file bodies that the kernel only spools between operation nodes; if so, how can the kernel detect them without inspecting file content, and if not, what observable protection applies?",
    "When a service-returned file contains a configured secret verbatim, is the file exempt from secret detection and governed only by its declared disclosure class, or must the kernel inspect and withhold it?"
   ],
   "units": [
    "00_product.md:Actors and trust boundaries"
   ],
   "id": "T1",
   "judgement": {
    "kind": "contradiction",
    "quotes": [
     "A service's own answer body that echoes one verbatim is withheld from everyone, the owner included, and never used as an output;",
     "the kernel does not inspect file content."
    ],
    "later_state": null,
    "divergence": "",
    "why": "The first passage requires detection and withholding for every service answer body, while the second forbids inspecting the contents of service-returned files.",
    "verified": true,
    "blocking": true
   }
  }
