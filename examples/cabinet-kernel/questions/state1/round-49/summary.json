 "topics": [
  {
   "topic": "Whether a FlowConstant satisfies an input port and prevents guard-based skipping",
   "members": [
    "r1.00",
    "r2.00",
    "r3.01"
   ],
   "runs": [
    1,
    2,
    3
   ],
   "questions": [
    "When an input port also receives a FlowConstant, does that constant count as a delivery that prevents `skipped_by_guard`, or are constants and incoming edges forbidden from targeting the same port?",
    "When an input port is supplied by a FlowConstant, does that constant count as an available input that prevents the port from causing `skipped_by_guard`, even though the rule speaks only of incoming edges?",
    "When an input port also receives a FlowConstant, does that constant satisfy the port and prevent `skipped_by_guard`, or is skipping determined solely from incoming FlowEdges?"
   ],
   "units": [
    "01_models.md:Model M15 — FlowEdge"
   ],
   "id": "T1",
   "judgement": {
    "kind": "answered_later",
    "quotes": [
     "a port with a constant has no other\n      constant and no edge;",
     "At start, each flow input's value is delivered along every edge from that\n   input, and each constant to its port (constants were validated when the\n   version was composed and proven, A05);"
    ],
    "later_state": null,
    "divergence": "",
    "why": "State 2 says a constant is delivered to and satisfies its port, while proof forbids any edge from also targeting that port, so guard-based skipping applies only to edge-supplied ports that become unreachable.",
    "verified": true,
    "blocking": false
   }
  },
