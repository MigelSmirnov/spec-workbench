 "topics": [
  {
   "topic": "Scope of credential scanning in service answer bodies",
   "members": [
    "r2.00",
    "r3.00"
   ],
   "runs": [
    2,
    3
   ],
   "questions": [
    "For a response body larger than service_response_bytes_max, must the kernel detect a verbatim credential occurring beyond the bytes it reads, or does “any answer body” mean only the prefix read up to the ceiling?",
    "Must an answer body, including a file body, be searched only for the credential sent on that request, or for every service credential or token known to the installation?"
   ],
   "units": [
    "context"
   ],
   "id": "T1",
   "judgement": {
    "kind": "answered",
    "quotes": [
     "Every body as read, whatever its status — reading stops at the ceiling\n   (rule 5) — is searched, before it is parsed or cut, for the bytes of the credential\n   value sent with the request; when they occur, the body is\n   dropped whole and `failure_detail` is exactly `error body withheld: it\n   contained the credential` (A17 rule 2)."
    ],
    "later_state": null,
    "divergence": "",
    "why": "The scan covers only the response bytes read up to the ceiling and searches only for the credential value sent with that request, including when the response is a file body.",
    "verified": true,
    "blocking": false
   }
  }
 ],
