 "topics": [
  {
   "topic": "Whether recovery advances reachable elements when other elements in the same run remain waiting",
   "members": [
    "r1.00",
    "r3.00"
   ],
   "runs": [
    1,
    3
   ],
   "questions": [
    "When one element must be reached for a fresh approval or has become reachable after an approval decision, but another element of the same run still waits, is the reachable element processed or is the entire run left untouched?",
    "When one element becomes reachable during recovery but another element of the same run still waits, must recovery advance the reachable element and independent ready branches, or must any remaining wait prevent all advancement?"
   ],
   "units": [
    "40_flows.md:`flow:start_and_recover_kernel`"
   ],
   "id": "T1",
   "judgement": {
    "kind": "contradiction",
    "quotes": [
     "a wait for an approval never requested — an attempt the owner resolved `not_applied` — is reached again through `capability:effects.reach_operation_element` for its fresh approval (A11 rule 3);",
     "an element not reached, with no record and no requested approval, is reached by the advance;",
     "A run that still waits has only its lagging status and waiting points rewritten, and nothing of it is reached."
    ],
    "later_state": null,
    "divergence": "",
    "why": "The first two passages require reachable elements to be processed during recovery, while the third forbids reaching anything whenever another wait leaves the run waiting.",
    "verified": true,
    "blocking": true
   }
  }
 ],
