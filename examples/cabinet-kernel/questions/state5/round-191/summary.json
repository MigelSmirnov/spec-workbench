 "topics": [
  {
   "topic": "Whether input and output ports must be normalized to Unicode code-point name order",
   "members": [
    "r1.00",
    "r2.00",
    "r3.00"
   ],
   "runs": [
    1,
    2,
    3
   ],
   "questions": [
    "When the caller supplies input or output Ports out of name order, must the returned and recorded binding carry each direction's Ports in Unicode code-point name order?",
    "Must a successful proposal be stored and returned with its input ports and output ports normalized into Unicode code-point name order, regardless of the order supplied by the caller?",
    "Must the returned and recorded binding carry both its input Ports and its output Ports in Unicode code-point name order even when the caller supplied either list in another order?"
   ],
   "units": [
    "?"
   ],
   "witnessed_by": [
    "r1.00",
    "r2.00",
    "r3.00"
   ],
   "id": "T1",
   "judgement": {
    "kind": "answered",
    "quotes": [
     "A proposal that passes every check of rule 5 but gives its input and output\n   ports out of name order is recorded, and the answer is that one binding with\n   its ports in name order; another proposal of the same operation already in\n   the store is not the answer. A proposal failing a check of rule 5 is refused\n   whatever its port order."
    ],
    "later_state": null,
    "divergence": "",
    "why": "State 2 explicitly requires both recorded and returned binding ports to be in name order when supplied out of order.",
    "decision_owner": "State 2",
    "options": [
     "Canonicalize input and output Ports into name order before recording and return that canonical binding.",
     "Preserve the caller-supplied Port order in the recorded and returned binding."
    ],
    "verified": true,
    "witness": {
     "outcomes": [
      "",
      ""
     ]
    },
