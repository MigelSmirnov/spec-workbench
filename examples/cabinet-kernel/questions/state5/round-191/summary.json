  "raw": "{\"judgements\":[{\"id\":\"T1\",\"kind\":\"answered\",\"quotes\":[\"A proposal that passes every check of rule 5 but gives its input and output\\n   ports out of name order is recorded, and the answer is that one binding with\\n   its ports in name order; another proposal of the same operation already in\\n   the store is not the answer. A proposal failing a check of rule 5 is refused\\n   whatever its port order.\"],\"later_state\":null,\"precedent\":null,\"divergence\":\"\",\"why\":\"State 2 explicitly requires both recorded and returned binding ports to be in name order when supplied out of order.\",\"decision_owner\":\"State 2\",\"requirement\":\"\",\"options\":[\"Canonicalize input and output Ports into name order before recording and return that canonical binding.\",\"Preserve the caller-supplied Port order in the recorded and returned binding.\"],\"consequences\":[],\"owner_question\":\"\",\"witness\":{\"initial\":\"\",\"events\":[],\"outcomes\":[\"\",\"\"],\"observer\":\"\",\"basis\":[]},\"bases\":[],\"rule\":\"\",\"section\":\"\"},{\"id\":\"T2\",\"kind\":\"answered\",\"quotes\":[\"`binding_id`: minted at random by the kernel when proposed; two proposals with\\n  equal content are two bindings;\",\"A proposal that passes every check of rule 5 but gives its input and output\\n   ports out of name order is recorded, and the answer is that one binding with\\n   its ports in name order; another proposal of the same operation already in\\n   the store is not the answer. A proposal failing a check of rule 5 is refused\\n   whatever its port order.\"],\"later_state\":null,\"precedent\":null,\"divergence\":\"\",\"why\":\"State 1 makes equal proposals separate bindings, and State 2 requires the newly recorded binding—not an existing proposal—to be returned.\",\"decision_owner\":\"State 2\",\"requirement\":\"\",\"options\":[\"Always create and return a distinct proposed binding, even when an equal proposal already exists.\",\"Return the existing equal binding and record nothing new.\",\"Create a new binding but return the previously stored equal binding.\"],\"consequences\":[],\"owner_question\":\"\",\"witness\":{\"initial\":\"\",\"events\":[],\"outcomes\":[\"\",\"\"],\"observer\":\"\",\"basis\":[]},\"bases\":[],\"rule\":\"\",\"section\":\"\"}]}",
