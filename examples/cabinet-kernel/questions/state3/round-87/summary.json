 "topics": [
  {
   "topic": "Bound used for the runner's per-file scratch file-size setrlimit",
   "members": [
    "r1.00",
    "r2.00",
    "r3.00"
   ],
   "runs": [
    1,
    2,
    3
   ],
   "questions": [
    "Which owned bound supplies the hard and soft `setrlimit` value for “the size of a file written in the scratch,” given that ResourceBounds M04 has no scratch or file-size field and A20 defines only the global `sandbox_scratch_bytes_max`?",
    "Which bound does the runner use as the soft and hard `setrlimit` value for a single scratch file?",
    "What value sets the runner’s file-size limit, given that M04 has no file-size field and A20 defines only the aggregate `sandbox_scratch_bytes_max` ceiling?"
   ],
   "units": [
    "context"
   ],
   "id": "T1",
   "judgement": {
    "kind": "answered_later",
    "quotes": [
     "The runner MUST set every setrlimit limit inside the sandbox's user namespace before it loads the code, soft and hard alike (every limit is set soft and hard to the same value; bubblewrap is started without any capability option, so the code holds none and cannot raise a limit): address space at bounds.memory_bytes, the size of a file written in the scratch at the imported RELEASE_CEILING_SANDBOX_SCRATCH_BYTES_MAX constant, and the outer process bound, the limit on the number of processes at bounds.process_count + 1;"
    ],
    "later_state": 8,
    "divergence": "",
    "why": "State 8 explicitly assigns both the soft and hard per-file scratch limit to RELEASE_CEILING_SANDBOX_SCRATCH_BYTES_MAX.",
    "verified": true,
    "blocking": false
   }
  }
 ],
