   ],
   "questions": [
    "Must a response to a size or token failure use null because the body cannot be read, or must the body be read to recover its id?"
   ],
   "units": [
    "surface"
   ],
   "id": "surface:T1",
   "judgement": {
    "kind": "judged_before",
    "quotes": [],
    "later_state": null,
    "divergence": "",
    "why": "This asks the same question about recovering a response id for size or token failures from the same unchanged passages.",
    "precedent": {
     "id": "P2",
     "round": "round-02",
     "topic": "Whether refusal responses must read the body to recover a request id",
     "kind": "answered",
     "quotes": [
      "The body is one JSON-RPC 2.0 message, read only after the size and token checks.",
      "The id of every response is the body's id member when the body is one JSON object whose id is a string or an integer, and null otherwise; reading it checks nothing and decides nothing."
     ],
     "why": "The body is not read before size and token checks, so refusals at those checks cannot recover its id and use null."
    },
    "verified": true,
    "blocking": false
   }
  }
