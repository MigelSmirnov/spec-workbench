{
  "standard_version": 2,
  "default_module": "store",
  "models": {
    "RecordStatus": {
      "kind": "enum",
      "values": [
        "draft",
        "published",
        "archived"
      ]
    },
    "Record": {
      "identity": "entity",
      "fields": {
        "record_id": "str",
        "title": "str",
        "status": "RecordStatus"
      }
    },
    "StoreRepository": {
      "kind": "interface"
    }
  },
  "contracts": {
    "StoreRepository.load_record": "(self, record_id: str) -> Record | None",
    "StoreRepository.save_record": "(self, record: Record) -> None",
    "publish_record": "(repository: StoreRepository, record_id: str) -> Record"
  },
  "module_functions": {
    "models": [
      "RecordStatus",
      "Record",
      "StoreRepository"
    ],
    "store": [
      "publish_record"
    ]
  },
  "function_order": [
    "publish_record"
  ],
  "module_order": [
    "models",
    "store"
  ],
  "module_paths": {
    "models": "demo/models",
    "store": "demo/store"
  },
  "imports": {
    "stdlib": [],
    "third_party": [],
    "internal": {
      "models": [
        "Record",
        "RecordStatus",
        "StoreRepository"
      ],
      "store": [
        "publish_record"
      ]
    },
    "module_internal": {
      "store": {
        "models": [
          "Record",
          "RecordStatus",
          "StoreRepository"
        ]
      }
    }
  },
  "notes": [
    "publish_record: [BEHAVIOR] MUST load the record with StoreRepository.load_record, set its status to the published member of RecordStatus and save it with StoreRepository.save_record.",
    "publish_record: [VALIDATION_ERROR] MUST raise LookupError when StoreRepository.load_record answers None."
  ],
  "config": {
    "role": "data",
    "schema_version": 1
  },
  "rules": {
    "role": "data",
    "schema_version": 1
  },
  "properties": {},
  "determinism": {},
  "implementation_obligations": {
    "StoreRepository": {
      "disposition": "external"
    }
  }
}
