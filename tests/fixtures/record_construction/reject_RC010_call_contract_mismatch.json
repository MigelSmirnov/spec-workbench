{
  "standard_version": 3,
  "models": {
    "ActorKind": {
      "kind": "enum",
      "base": "str",
      "values": [
        "staff",
        "viewer"
      ]
    },
    "AuditAction": {
      "kind": "enum",
      "base": "str",
      "values": [
        "expense.create",
        "expense.withdraw"
      ]
    },
    "ExpenseStatus": {
      "kind": "enum",
      "base": "str",
      "values": [
        "active",
        "withdrawn"
      ]
    },
    "AllocationInstruction": {
      "fields": {
        "section_id": "UUID",
        "amount": "Decimal",
        "note": "str | None"
      },
      "identity": "value"
    },
    "ExpenseIntake": {
      "fields": {
        "project_id": "UUID",
        "supplier": "str",
        "total_amount": "Decimal",
        "currency": "str",
        "confirmed_by": "UUID",
        "confirmed_at": "datetime",
        "status_code": "str",
        "allocations": "list[AllocationInstruction]",
        "reviewer_id": "UUID | None"
      },
      "identity": "value"
    },
    "Expense": {
      "fields": {
        "expense_id": "UUID",
        "project_id": "UUID",
        "supplier": "str",
        "total_amount": "Decimal",
        "status": "ExpenseStatus",
        "included": "bool",
        "created_at": "datetime",
        "created_by": "UUID",
        "updated_at": "datetime | None",
        "reviewed": "bool"
      },
      "identity": "entity"
    },
    "ExpenseAllocation": {
      "fields": {
        "allocation_id": "UUID",
        "expense_id": "UUID",
        "section_id": "UUID",
        "amount": "Decimal",
        "note": "str | None"
      },
      "identity": "entity"
    },
    "ExpenseAggregate": {
      "fields": {
        "expense": "Expense",
        "allocations": "tuple[ExpenseAllocation, ...]",
        "labels": "list[str]"
      },
      "identity": "value"
    },
    "AuditIntent": {
      "fields": {
        "actor_kind": "ActorKind",
        "actor_id": "UUID | None",
        "action": "AuditAction",
        "entity_id": "str | None",
        "currency_code": "str",
        "amount": "Decimal"
      },
      "identity": "value"
    },
    "AuditRecord": {
      "fields": {
        "intent": "AuditIntent",
        "recorded": "bool"
      },
      "identity": "value"
    },
    "AllocationView": {
      "fields": {
        "section_id": "str",
        "amount": "Decimal",
        "has_note": "bool",
        "recorded_at": "datetime"
      },
      "identity": "value"
    }
  },
  "contracts": {
    "build_expense_aggregate": "(intake: ExpenseIntake, created_at: datetime) -> ExpenseAggregate",
    "build_audit_intent": "(actor_id: UUID, action: AuditAction, entity_id: UUID, amount: Decimal) -> AuditIntent",
    "build_creation_audit": "(created_by: UUID, action: AuditAction, expense_id: UUID, amount: Decimal) -> AuditRecord",
    "withdraw_expense": "(expense: Expense, updated_at: datetime) -> Expense",
    "build_allocation_views": "(allocations: list[ExpenseAllocation], recorded_at: datetime) -> list[AllocationView]",
    "round_amount": "(amount: Decimal) -> Decimal",
    "record_expense": "(intake: ExpenseIntake) -> ExpenseAggregate",
    "write_audit": "(actor_id: UUID, entity_id: UUID) -> AuditIntent",
    "list_allocation_views": "(allocations: list[ExpenseAllocation]) -> list[AllocationView]"
  },
  "determinism": {
    "build_expense_aggregate": false,
    "build_audit_intent": true,
    "build_creation_audit": true,
    "withdraw_expense": true,
    "build_allocation_views": true,
    "round_amount": false,
    "record_expense": false,
    "write_audit": true,
    "list_allocation_views": true
  },
  "module_functions": {
    "record_builders": [
      "build_allocation_views",
      "build_audit_intent",
      "build_creation_audit",
      "build_expense_aggregate",
      "withdraw_expense"
    ],
    "money_policy": [
      "round_amount"
    ],
    "policy_data": [
      "DEFAULT_CURRENCY"
    ],
    "expense_intake": [
      "record_expense"
    ],
    "audit_writer": [
      "write_audit"
    ],
    "expense_views": [
      "list_allocation_views"
    ]
  },
  "module_paths": {
    "models": "core/models",
    "policy_data": "core/policy_data",
    "money_policy": "domain/money_policy",
    "record_builders": "domain/record_builders",
    "expense_intake": "services/expense_intake",
    "audit_writer": "services/audit_writer",
    "expense_views": "services/expense_views"
  },
  "imports": {
    "module_internal": {
      "record_builders": {
        "models": [
          "AllocationView",
          "AuditIntent",
          "AuditRecord",
          "Expense",
          "ExpenseAggregate",
          "ExpenseAllocation",
          "ExpenseIntake",
          "ActorKind",
          "AuditAction",
          "ExpenseStatus"
        ],
        "money_policy": [
          "round_amount"
        ],
        "policy_data": [
          "DEFAULT_CURRENCY"
        ]
      },
      "expense_intake": {
        "models": [
          "ExpenseAggregate",
          "ExpenseIntake"
        ],
        "record_builders": [
          "build_creation_audit",
          "build_expense_aggregate",
          "withdraw_expense"
        ]
      },
      "audit_writer": {
        "models": [
          "AuditIntent"
        ],
        "record_builders": [
          "build_audit_intent"
        ]
      },
      "expense_views": {
        "models": [
          "AllocationView",
          "ExpenseAllocation"
        ],
        "record_builders": [
          "build_allocation_views"
        ]
      },
      "money_policy": {}
    }
  },
  "rules": {
    "data_provider_backend": {
      "kind": "data_provider_backend",
      "schema_version": 2,
      "backend": {
        "emitter": "python_constant_data_v1"
      },
      "wiring": {
        "module": "policy_data",
        "models_module": "core.models"
      },
      "constants": {
        "DEFAULT_CURRENCY": {
          "value_type": "string",
          "value": "EUR"
        }
      }
    },
    "record_construction_backend": {
      "kind": "record_construction_backend",
      "schema_version": 1,
      "backend": {
        "emitter": "python_record_builders_v1"
      },
      "wiring": {
        "module": "record_builders",
        "models_module": "core.models"
      },
      "constructions": {
        "build_expense_aggregate": {
          "form": "construct",
          "target": "ExpenseAggregate",
          "consumers": [
            "expense_intake"
          ],
          "over": null,
          "element": null,
          "base": null,
          "parts": {
            "expense": {
              "target": "Expense",
              "over": null,
              "element": null,
              "fields": {
                "expense_id": {
                  "ref": "fresh_id",
                  "kind": "uuid4"
                },
                "project_id": {
                  "ref": "field",
                  "of": "intake",
                  "field": "project_id"
                },
                "supplier": {
                  "ref": "field",
                  "of": "intake",
                  "field": "supplier"
                },
                "total_amount": {
                  "ref": "field",
                  "of": "intake",
                  "field": "total_amount"
                },
                "status": {
                  "ref": "field",
                  "of": "intake",
                  "field": "status_code",
                  "convert": "enum_by_value"
                },
                "included": {
                  "ref": "literal",
                  "value": true
                },
                "created_at": {
                  "ref": "name",
                  "name": "created_at"
                },
                "created_by": {
                  "ref": "field",
                  "of": "intake",
                  "field": "confirmed_by"
                },
                "updated_at": {
                  "ref": "none"
                },
                "reviewed": {
                  "ref": "field",
                  "of": "intake",
                  "field": "reviewer_id",
                  "convert": "is_present"
                }
              }
            },
            "allocations": {
              "target": "ExpenseAllocation",
              "over": {
                "ref": "field",
                "of": "intake",
                "field": "allocations"
              },
              "element": "instruction",
              "fields": {
                "allocation_id": {
                  "ref": "fresh_id",
                  "kind": "uuid4"
                },
                "expense_id": {
                  "ref": "part_field",
                  "part": "expense",
                  "field": "expense_id"
                },
                "section_id": {
                  "ref": "field",
                  "of": "instruction",
                  "field": "section_id"
                },
                "amount": {
                  "ref": "field",
                  "of": "instruction",
                  "field": "amount"
                },
                "note": {
                  "ref": "field",
                  "of": "instruction",
                  "field": "note"
                }
              }
            }
          },
          "fields": {
            "expense": {
              "ref": "part",
              "name": "expense"
            },
            "allocations": {
              "ref": "part",
              "name": "allocations"
            },
            "labels": {
              "ref": "empty"
            }
          },
          "dropped": {
            "intake": {
              "currency": {
                "reason": "checked_only",
                "decision": "M27"
              },
              "confirmed_at": {
                "reason": "stored_elsewhere",
                "decision": null
              }
            }
          }
        },
        "build_audit_intent": {
          "form": "construct",
          "target": "AuditIntent",
          "consumers": [
            "audit_writer"
          ],
          "over": null,
          "element": null,
          "base": null,
          "parts": {},
          "fields": {
            "actor_kind": {
              "ref": "enum",
              "type": "ActorKind",
              "member": "STAFF"
            },
            "actor_id": {
              "ref": "name",
              "name": "actor_id"
            },
            "action": {
              "ref": "name",
              "name": "action"
            },
            "entity_id": {
              "ref": "name",
              "name": "entity_id",
              "convert": "uuid_canonical_string"
            },
            "currency_code": {
              "ref": "constant",
              "symbol": "DEFAULT_CURRENCY"
            },
            "amount": {
              "ref": "call",
              "function": "round_amount",
              "args": [
                "amount"
              ]
            }
          },
          "dropped": {}
        },
        "build_creation_audit": {
          "form": "construct",
          "target": "AuditRecord",
          "consumers": [
            "expense_intake"
          ],
          "over": null,
          "element": null,
          "base": null,
          "parts": {},
          "fields": {
            "intent": {
              "ref": "call",
              "function": "build_audit_intent",
              "args": [
                "created_by",
                "action",
                "expense_id",
                "amount"
              ]
            },
            "recorded": {
              "ref": "literal",
              "value": true
            }
          },
          "dropped": {}
        },
        "withdraw_expense": {
          "form": "replace",
          "target": "Expense",
          "consumers": [
            "expense_intake"
          ],
          "over": null,
          "element": null,
          "base": "expense",
          "parts": {},
          "fields": {
            "status": {
              "ref": "enum",
              "type": "ExpenseStatus",
              "member": "WITHDRAWN"
            },
            "included": {
              "ref": "literal",
              "value": false
            },
            "updated_at": {
              "ref": "name",
              "name": "updated_at"
            }
          },
          "dropped": {}
        },
        "build_allocation_views": {
          "form": "construct",
          "target": "AllocationView",
          "consumers": [
            "expense_views"
          ],
          "over": {
            "ref": "name",
            "name": "allocations"
          },
          "element": "allocation",
          "base": null,
          "parts": {},
          "fields": {
            "section_id": {
              "ref": "field",
              "of": "allocation",
              "field": "section_id",
              "convert": "uuid_canonical_string"
            },
            "amount": {
              "ref": "field",
              "of": "allocation",
              "field": "amount"
            },
            "has_note": {
              "ref": "field",
              "of": "allocation",
              "field": "note",
              "convert": "is_present"
            },
            "recorded_at": {
              "ref": "name",
              "name": "recorded_at",
              "convert": "naive_utc"
            }
          },
          "dropped": {
            "allocation": {
              "allocation_id": {
                "reason": "not_in_target",
                "decision": null
              },
              "expense_id": {
                "reason": "not_in_target",
                "decision": null
              }
            }
          }
        }
      }
    }
  }
}
